MERGE (p:Paper {number: '226'}) SET p.title = 'A new class of cancer-associated PTEN mutations deﬁned by membrane translocation defects', p.year = 2014, p.journal = 'Oncogene', p.doi = '10.1038/onc.2014.293', p.key_findings = 'The study identifies a new class of cancer-associated PTEN mutations that retain enzymatic activity but fail to translocate to the plasma membrane, leading to impaired tumor suppressor function. Artificial membrane tethering of these mutants restores their activity and represses excess PIP3 signaling. This reveals a novel mechanism of tumorigenic PTEN deficiency, highlighting the importance of membrane localization for PTEN\'s function in cancer biology.', p.paper_type = 'research_article', p.authors = 'Nguyen, H-N, Yang Jr, J-M, Rahdar, M, Keniry, M, Swaney, KF, Parsons, R, Park, BH, Sesaki, H, Devreotes, PN, Iijima, M';
