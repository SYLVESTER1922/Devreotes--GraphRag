MERGE (p:Paper {number: '223'}) SET p.title = 'Engineering ePTEN, an enhanced PTEN with increased tumor suppressor activities', p.year = 2014, p.journal = 'Proceedings of the National Academy of Sciences', p.doi = '10.1073/pnas.1409433111', p.key_findings = 'The study successfully engineered an enhanced version of PTEN (ePTEN) that exhibits increased membrane localization and PIP3 phosphatase activity, significantly reducing PIP3 levels and downstream AKT phosphorylation in human cells. This suggests that activating PTEN could be a viable therapeutic strategy for cancers characterized by elevated PIP3 signaling. The research highlights the importance of specific mutations in PTEN that enhance its tumor suppressor functions.', p.paper_type = 'research_article', p.authors = 'Nguyen, H.-N., Yang, J.-M., Afkari, Y., Park, B.H., Sesaki, H., Devreotes, P.N., Iijima, M.';
MERGE (pr:Protein {name: 'phosphatase and tensin homolog (PTEN)'}) WITH pr MATCH (p:Paper {number: '223'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'PTEN is a major tumor suppressor that dephosphorylates PIP3, regulating cell proliferation and migration.'}]->(pr);
MERGE (pr:Protein {name: 'enhanced PTEN (ePTEN)'}) WITH pr MATCH (p:Paper {number: '223'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'ePTEN is engineered to have increased membrane localization and PIP3 phosphatase activity.'}]->(pr);
MERGE (pr:Protein {name: 'AKT'}) WITH pr MATCH (p:Paper {number: '223'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'AKT is a major downstream target of PIP3 signaling whose phosphorylation is decreased by ePTEN.'}]->(pr);
