MERGE (p:Paper {number: '018'}) SET p.title = 'Cyclic 3\',5\'-AMP Relay in Dictyostelium discoideum IV. Recovery of the CAMP Signaling Response After Adaptation to CAMP', p.year = 1980, p.journal = 'The Journal of Cell Biology', p.doi = '', p.key_findings = 'The study characterizes the adaptation and deadaptation processes in Dictyostelium discoideum in response to cyclic AMP (cAMP) stimuli. It was found that the magnitude of the signaling response to a second cAMP stimulus is influenced by the duration and intensity of the first stimulus, with a recovery time of approximately 15 minutes needed for maximal response. The findings suggest that adaptation and excitation are antagonistic processes that regulate the cAMP signaling response, highlighting the dynamic nature of cellular signaling in response to environmental changes.', p.paper_type = 'research_article', p.authors = 'Dinauer, M.C., Steck, T.L., Devreotes, P.N.';
