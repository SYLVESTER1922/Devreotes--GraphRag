MERGE (p:Paper {number: '273'}) SET p.title = 'Editorial: Self-organizing and excitable signaling networks in cell biology', p.year = 2024, p.journal = 'Frontiers in Cell and Developmental Biology', p.doi = '10.3389/fcell.2024.1430911', p.key_findings = 'The editorial discusses the self-organizing and excitable dynamics of signaling networks in cell biology, highlighting their roles in processes such as cell migration, embryonic development, and cell proliferation. It emphasizes the importance of live cell imaging and mathematical modeling in understanding these networks. The findings suggest that excitability in signaling networks can lead to coordinated cellular responses and may have implications for understanding disease mechanisms.', p.paper_type = 'editorial', p.authors = 'Huang, C.-H., Albeck, J.G., Devreotes, P.N.';
