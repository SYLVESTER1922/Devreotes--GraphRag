MERGE (p:Paper {number: '278'}) SET p.title = 'Self-organizing glycolytic waves fuel cell migration and cancer progression', p.year = 2024, p.journal = 'bioRxiv', p.doi = '10.1101/2024.01.28.577603', p.key_findings = 'The study reveals that glycolytic enzymes are localized in cortical waves in human epithelial cells, which are correlated with increased ATP production and enhanced cell migration. The recruitment of these enzymes to the cell cortex is influenced by Ras/PI3K signaling and is associated with the metastatic potential of cancer cells. The findings suggest that the dynamic localization of glycolytic enzymes plays a crucial role in coordinating cellular protrusions and metabolic activity, contributing to the Warburg effect observed in cancer cells.', p.paper_type = 'research_article', p.authors = 'Zhan, H., Pal, D.S., Borleis, J., Janetopoulos, C., Huang, C.-H., Devreotes, P.N.';
