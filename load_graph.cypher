MERGE (p:Paper {number: '028'}) SET p.title = 'Specific Photoaffinity Labeling of the cAMP Surface Receptor in Dictyostelium discoideum', p.year = 1984, p.journal = 'THE JOURNAL OF BIOLOGICAL CHEMISTRY', p.doi = '', p.key_findings = 'The study successfully identified the cAMP surface receptor in Dictyostelium discoideum through specific photoaffinity labeling. The receptor was shown to migrate as a doublet on SDS-PAGE, with significant labeling correlating with cAMP-binding activity. This identification opens avenues for further biochemical characterization of the receptor, which plays a crucial role in mediating chemotaxis during the organism\'s development.', p.paper_type = 'research_article', p.authors = 'Theibert, A., Klein, P., Devreotes, P. N.';
