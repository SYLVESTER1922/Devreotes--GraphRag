MERGE (p:Paper {number: '017'}) SET p.title = 'Cyclic 3\',5\'-AMP Relay in Dictyostelium discoideum III. The Relationship of CAMP Synthesis and Secretion during the CAMP Signaling Response', p.year = 1980, p.journal = 'The Journal of Cell Biology', p.doi = '', p.key_findings = 'The study found that cAMP secretion is proportional to intracellular cAMP concentration during signaling responses. The activation of adenylate cyclase is a key factor in determining the time-course of cAMP secretion. Additionally, the decline in intracellular cAMP after stimulus removal suggests that phosphodiesterase activity plays a significant role in regulating cAMP levels. These findings enhance the understanding of cAMP signaling mechanisms in Dictyostelium discoideum.', p.paper_type = 'research_article', p.authors = 'Dinauer, M.C., Mackay, S.A., Devreotes, P.N.';
