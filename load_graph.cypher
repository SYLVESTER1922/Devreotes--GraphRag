MERGE (p:Paper {number: '123'}) SET p.title = 'A novel cytosolic regulator, Pianissimo, is required for chemoattractant receptor and G protein-mediated activation of the 12 transmembrane domain adenylyl cyclase in Dictyostelium', p.year = 1997, p.journal = 'Genes & Development', p.doi = '', p.key_findings = 'The study identifies Pianissimo (PiaA) as a novel cytosolic regulator essential for the activation of adenylyl cyclase in response to chemoattractant signals in Dictyostelium discoideum. PiaA is required for both receptor and G protein-mediated activation of the enzyme, and its absence leads to defects in cAMP signaling and aggregation during development. The findings suggest that similar regulatory mechanisms may exist in higher eukaryotes, highlighting the evolutionary significance of these pathways.', p.paper_type = 'research_article', p.authors = 'Chen, Mei-Yu, Long, Yu, Devreotes, Peter N.';
