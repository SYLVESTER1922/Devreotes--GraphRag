MERGE (c:Concept {name: 'biphasic relationship'}) WITH c MATCH (p:Paper {number: '276'}) MERGE (p)-[:EXPLORES_CONCEPT {context: 'The study reveals a biphasic relationship between Ras activity and cell migration, indicating that both high and low Ras activity can impair migration.'}]->(c);
