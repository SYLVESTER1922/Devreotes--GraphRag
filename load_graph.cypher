MERGE (p:Paper {number: '206'}) SET p.title = 'Assessment of Development and Chemotaxis in Dictyostelium discoideum Mutants', p.year = 2011, p.journal = 'Methods in Molecular Biology', p.doi = '10.1007/978-1-61779-207-6_20', p.key_findings = 'The study identifies new potential regulators of chemotaxis in Dictyostelium discoideum by screening REMI mutants for developmental defects. It highlights the importance of cAMP and its receptor cAR1 in mediating chemotactic responses. Additionally, the research emphasizes the role of PIP3 and actin dynamics in the signaling pathways that govern directed migration. These findings contribute to a deeper understanding of the molecular mechanisms underlying chemotaxis and multicellular development.', p.paper_type = 'research_article', p.authors = 'Yulia Artemenko, Kristen F. Swaney, Peter N. Devreotes';
