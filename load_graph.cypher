MERGE (p:Paper {number: '209'}) SET p.title = 'Moving in the right direction: How eukaryotic cells migrate along chemical gradients', p.year = 2011, p.journal = 'Seminars in Cell & Developmental Biology', p.doi = '10.1016/j.semcdb.2011.07.020', p.key_findings = 'The review discusses the mechanisms by which eukaryotic cells, particularly Dictyostelium and neutrophils, migrate along chemical gradients. It highlights the role of GPCRs in detecting chemoattractants and the subsequent signaling pathways, including the activation of PI3K and the production of PIP3, which are crucial for directional sensing and motility. The paper emphasizes the conservation of these mechanisms across different cell types and their importance in various biological processes such as immune response and development.', p.paper_type = 'review', p.authors = 'Cai, H., Devreotes, P.N.';
