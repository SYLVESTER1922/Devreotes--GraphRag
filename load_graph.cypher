MERGE (p:Paper {number: '199'}) SET p.title = 'Automated characterization of cell shape changes during amoeboid motility by skeletonization', p.year = 2010, p.journal = 'BMC Systems Biology', p.doi = '10.1186/1752-0509-4-33', p.key_findings = 'The study presents a novel method for automatically detecting and characterizing pseudopodial behavior in cells during amoeboid motility. By employing skeletonization and other image processing techniques, the authors demonstrate the ability to capture the spatial and temporal dynamics of pseudopodial activities. This method provides a powerful tool for investigating the mechanisms underlying cell motility, which is crucial for various biological processes such as immune response and tissue development.', p.paper_type = 'methods', p.authors = 'Xiong, Yuan, Kabacoff, Cathryn, Franca-Koh, Jonathan, Devreotes, Peter N, Robinson, Douglas N, Iglesias, Pablo A';
