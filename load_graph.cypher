MERGE (p:Paper {number: '224'}) SET p.title = 'A Unified Nomenclature and Amino Acid Numbering for Human PTEN', p.year = 2014, p.journal = 'Science Signaling', p.doi = '10.1126/scisignal.2005560', p.key_findings = 'The paper proposes a unified nomenclature and amino acid numbering system for the PTEN and PTEN-L proteins to avoid confusion in the scientific literature. It highlights the importance of distinguishing between the two forms of PTEN, especially in the context of mutations that affect their function. The authors emphasize that this standardized naming will facilitate research and clinical understanding of PTEN-related disorders.', p.paper_type = 'perspective', p.authors = 'Rafael Pulido, Suzanne J. Baker, Joao T. Barata, Arkaitz Carracedo, Victor J. Cid, Ian D. Chin-Sang, Vrushank Davé, Jeroen den Hertog, Peter Devreotes, Britta J. Eickholt, Charis Eng, Frank B. Furnari, Maria-Magdalena Georgescu, Arne Gericke, Benjamin Hopkins, Xeujun Jiang, Seung-Rock Lee, Mathias Lösche, Prerna Malaney, Xavier Matias-Guiu, María Molina, Pier Paolo Pandolfi, Ramon Parsons, Paolo Pinton, Carmen Rivas, Rafael M. Rocha, Manuel S. Rodríguez, Alonzo H. Ross, Manuel Serrano, Vuk Stambolic, Bangyan Stiles, Akira Suzuki, Seong-Seng Tan, Nicholas K. Tonks, Lloyd C. Trotman, Nicolas Wolff, Rudiger Woscholski, Hong Wu, Nicholas R. Leslie';
