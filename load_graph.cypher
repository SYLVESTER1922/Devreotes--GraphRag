MERGE (p:Paper {number: '150'}) SET p.title = 'Extracellular cAMP inhibits proximal reabsorption: are plasma membrane cAMP receptors involved?', p.year = 2002, p.journal = 'American Journal of Physiology - Renal Physiology', p.doi = '10.1152/ajprenal.00202.2001', p.key_findings = 'The review highlights that extracellular cAMP plays a significant role in inhibiting sodium and phosphate reabsorption in the renal proximal tubule, mediated by glucagon. It suggests that cAMP should be considered not only as an intracellular second messenger but also as a first messenger that coordinates hepatorenal functions. The existence of specific cAMP receptors in mammals remains to be demonstrated, although they are well characterized in lower eukaryotes like Dictyostelium discoideum.', p.paper_type = 'review', p.authors = 'Bankir, Lise, Ahloulay, Mina, Devreotes, Peter N., Parent, Carole A.';
