MERGE (p:Paper {number: '256'}) SET p.title = 'Reverse fountain flow of phosphatidylinositol-3,4-bisphosphate polarizes migrating cells', p.year = 2021, p.journal = 'The EMBO Journal', p.doi = '10.15252/embj.2020105094', p.key_findings = 'The study uncovers a reverse-fountain flow of phosphatidylinositol-3,4-bisphosphate (PI(3,4)P2) that regulates cell polarity during migration. It demonstrates that PI(3,4)P2 is internalized in macropinosomes and transported to the back of the cell, where it is then degraded as it diffuses toward the front. This dynamic distribution of PI(3,4)P2 is crucial for maintaining the complementary localization of signaling molecules like Ras and PTEN, which are essential for effective chemotaxis. The findings suggest that vesicular trafficking plays a significant role in establishing and maintaining cell polarity in migrating cells.', p.paper_type = 'research_article', p.authors = 'Li, Xiaoguang, Pal, Dhiman Sankar, Biswas, Debojyoti, Iglesias, Pablo A, Devreotes, Peter N';
MERGE (pr:Protein {name: 'phosphatidylinositol-3,4-bisphosphate'}) WITH pr MATCH (p:Paper {number: '256'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'PI(3,4)P2 is shown to localize to retracting leading-edge protrusions and nascent macropinosomes.'}]->(pr);
MERGE (pr:Protein {name: 'Ras'}) WITH pr MATCH (p:Paper {number: '256'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'Ras activity is dynamically distributed in migrating cells, with mutual inhibition between Ras and PI(3,4)P2 activities.'}]->(pr);
MERGE (pr:Protein {name: 'PTEN'}) WITH pr MATCH (p:Paper {number: '256'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'PTEN is localized to the back of the cell and behaves complementarily to PI(3,4)P2.'}]->(pr);
MERGE (pr:Protein {name: 'Myosin II'}) WITH pr MATCH (p:Paper {number: '256'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'Myosin II is also localized to the back of the cell, contributing to the complementary distribution of molecules.'}]->(pr);
MERGE (pr:Protein {name: 'PIP3'}) WITH pr MATCH (p:Paper {number: '256'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'PIP3 is involved in the front events of cell migration and is compared to PI(3,4)P2 in the study.'}]->(pr);
MERGE (pr:Protein {name: 'tPH-CynA'}) WITH pr MATCH (p:Paper {number: '256'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'tPH-CynA is a biosensor used to visualize PI(3,4)P2 distribution in the cells.'}]->(pr);
MERGE (pr:Protein {name: 'PH-Crac'}) WITH pr MATCH (p:Paper {number: '256'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'PH-Crac is a biosensor used to detect PIP3 in the study.'}]->(pr);
