MERGE (c:Concept {name: 'PIP3 signaling'}) WITH c MATCH (p:Paper {number: '229'}) MERGE (p)-[:EXPLORES_CONCEPT {context: 'PTEN plays a key negative role in PIP3 signaling, which is important for cell proliferation, survival, and migration.'}]->(c);
