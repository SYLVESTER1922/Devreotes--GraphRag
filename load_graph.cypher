MERGE (p:Paper {number: '266'}) SET p.title = 'A dynamic partitioning mechanism polarizes membrane protein distribution', p.year = 2023, p.journal = 'bioRxiv', p.doi = '10.1101/2023.01.03.522496', p.key_findings = 'The study identifies a novel mechanism termed \'dynamic partitioning\' that explains how lipid-anchored and integral membrane proteins can polarize without dissociating from the membrane. This mechanism operates independently of cytoskeletal dynamics and vesicular trafficking, suggesting that membrane proteins can self-organize based on their biophysical properties. The findings have significant implications for understanding cell migration and polarity in various physiological contexts.', p.paper_type = 'research_article', p.authors = 'Banerjee, T., Matsuoka, S., Biswas, D., Miao, Y., Pal, D.S., Kamimura, Y., Ueda, M., Devreotes, P.N., Iglesias, P.A.';
