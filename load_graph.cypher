MERGE (p:Paper {number: '274'}) SET p.title = 'PIP5K-Ras bistability initiates plasma membrane symmetry breaking to regulate cell polarity and migration', p.year = 2024, p.journal = 'bioRxiv', p.doi = '10.1101/2024.09.15.613115', p.key_findings = 'The study reveals that the mutually exclusive localization of PIP5K and active Ras on the plasma membrane initiates symmetry breaking, which is crucial for establishing cell polarity and regulating migration. Knockout of PIP5K leads to increased Ras-PI3K activation and enhanced cell protrusion, while overexpression of PIP5K inhibits Ras signaling and migration. These findings suggest that PIP5K acts as a sensitive master regulator of these processes, with implications for understanding cell behavior in various contexts.', p.paper_type = 'research_article', p.authors = 'Deng, Y., Banerjee, T., Pal, D.S., Banerjee, P., Zhan, H., Borleis, J., Igleias, P.A., Devreotes, P.N.';
