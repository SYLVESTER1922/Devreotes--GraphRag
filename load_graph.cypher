MERGE (pr:Protein {name: 'SHIP1'}) WITH pr MATCH (p:Paper {number: '188'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'SHIP1 is responsible for the degradation and localization of PtdIns(3,4,5)P3 in neutrophils.'}]->(pr);
