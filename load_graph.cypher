MERGE (p:Paper {number: '011'}) SET p.title = 'NEWLY SYNTHESIZED ACETYLCHOLINE RECEPTORS ARE LOCATED IN THE GOLGI APPARATUS', p.year = 1978, p.journal = 'The Journal of Cell Biology', p.doi = '', p.key_findings = 'The study found that about half of the intracellular acetylcholine receptors are newly synthesized and located in the Golgi apparatus for approximately 2 hours before reaching the plasma membrane. The binding kinetics of iodinated α-bungarotoxin to both intracellular and surface acetylcholine receptors were comparable. The findings support the hypothesis that integral membrane glycoproteins, like acetylcholine receptors, follow a transport pathway similar to that of secretory proteins.', p.paper_type = 'research_article', p.authors = 'Fambrough, D.M., Devreotes, P.N.';
