MERGE (p:Paper {number: '061'}) SET p.title = 'Multiple α Subunits of Guanine Nucleotide-Binding Proteins in Dictyostelium', p.year = 1989, p.journal = 'Proceedings of the National Academy of Sciences of the United States of America', p.doi = '', p.key_findings = 'The study identifies two distinct G protein α subunits, G1 and G2, in Dictyostelium discoideum, which are differentially expressed during development. These proteins are shown to have distinct physiological functions, suggesting they may regulate different signal transduction pathways. The findings enhance the understanding of how G proteins contribute to chemotaxis and developmental processes in this model organism.', p.paper_type = 'research_article', p.authors = 'Pupillo, M., Kumagai, A., Pitt, G. S., Firtel, R. A., Devreotes, P. N.';
