MERGE (p:Paper {number: '167'}) SET p.title = 'Cyclic AMP Receptors of Dictyostelium', p.year = 2004, p.journal = 'Encyclopedia of Biological Chemistry', p.doi = '', p.key_findings = 'The study identifies the cAMP receptors (cAR1-4) in Dictyostelium discoideum and their roles in mediating aggregation and development. cAR1 is shown to couple with the G protein Ga2, activating downstream signaling pathways that regulate chemotaxis and gene expression. The cARs exhibit varying affinities for cAMP, which are crucial for their functions during different stages of development. The findings highlight the importance of GPCRs in understanding cellular communication and signaling in eukaryotes.', p.paper_type = 'research_article', p.authors = 'Hereld, D., Devreotes, P.N.';
