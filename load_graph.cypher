MERGE (p:Paper {number: '125'}) SET p.title = 'Switching of Chemoattractant Receptors Programs Development and Morphogenesis in Dictyostelium: Receptor Subtypes Activate Common Responses at Different Agonist Concentrations', p.year = 1998, p.journal = 'Developmental Biology', p.doi = '10.1006/dbio.1998.8882', p.key_findings = 'The study demonstrates that cAMP receptors cAR1, cAR2, and cAR3 can mediate similar responses during the aggregation stage of Dictyostelium development, despite differences in their affinity for cAMP. It was found that receptor switching allows the organism to adapt to varying concentrations of the chemoattractant, thereby programming morphogenesis. The research highlights the functional redundancy among receptor subtypes and the significance of specific amino acid residues in determining receptor affinity.', p.paper_type = 'research_article', p.authors = 'Kim, J. Y., Borleis, J. A., Devreotes, P. N.';
