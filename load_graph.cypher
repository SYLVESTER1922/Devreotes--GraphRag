MERGE (p:Paper {number: '242'}) SET p.title = 'NKCC1 Regulates Migration Ability of Glioblastoma Cells by Modulation of Actin Dynamics and Interacting with Coﬁlin', p.year = 2017, p.journal = 'EBioMedicine', p.doi = '10.1016/j.ebiom.2017.06.020', p.key_findings = 'The study demonstrates that NKCC1 plays a critical role in regulating the migration of glioblastoma cells by modulating actin dynamics and interacting with Cofilin-1. Knockdown of NKCC1 leads to decreased F-actin content and reduced activity of RhoA and Rac1, which are essential for cell migration. These findings suggest that targeting NKCC1 could be a promising therapeutic strategy to inhibit glioblastoma cell invasion and improve patient outcomes.', p.paper_type = 'research_article', p.authors = 'Schiapparelli, P., Guerrero-Cazares, H., Magaña-Maldonado, R., Hamilla, S.M., Ganaha, S., Goulin Lippi Fernandes, E., Huang, C.-H., Aranda-Espinoza, H., Devreotes, P., Quinones-Hinojosa, A.';
