MERGE (p:Paper {number: '255'}) SET p.title = 'Traveling and standing waves mediate pattern formation in cellular protrusions', p.year = 2020, p.journal = 'Science Advances', p.doi = '10.1126/sciadv.aay7682', p.key_findings = 'The study demonstrates that traveling waves can transform into standing waves without altering diffusion parameters, leading to stable patterns in cellular protrusions. This transformation allows cells to switch between excitability and bistability, providing a framework for understanding various protrusive phenotypes. The findings suggest a previously unidentified mechanism of pattern formation that governs cell motility, with implications for understanding cellular dynamics in different biological contexts.', p.paper_type = 'research_article', p.authors = 'Bhattacharya, S., Banerjee, T., Miao, Y., Zhan, H., Devreotes, P.N., Iglesias, P.A.';
