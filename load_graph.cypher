MERGE (p:Paper {number: '229'}) SET p.title = 'Engineering PTEN function: Membrane association and activity', p.year = 2014, p.journal = 'Methods', p.doi = '10.1016/j.ymeth.2014.10.018', p.key_findings = 'The study reveals that PTEN\'s membrane association is crucial for its tumor suppressor functions. By engineering PTEN variants with enhanced membrane association, the researchers demonstrated that these variants significantly suppress PIP3 signaling more effectively than wild-type PTEN. Additionally, a new class of cancer-associated PTEN mutations was identified that impairs membrane association, further emphasizing the importance of PTEN localization in its function. Overall, the findings provide insights into the molecular mechanisms regulating PTEN activity and its implications in cancer biology.', p.paper_type = 'research_article', p.authors = 'Yang, Jr-Ming, Nguyen, Hoai-Nghia, Sesaki, Hiromi, Devreotes, Peter N., Iijima, Miho';
