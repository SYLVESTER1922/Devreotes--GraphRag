MERGE (p:Paper {number: '251'}) SET p.title = 'A minimal computational model for three-dimensional cell migration', p.year = 2019, p.journal = 'J. R. Soc. Interface', p.doi = '10.1098/rsif.2019.0619', p.key_findings = 'The study presents a computational model that effectively simulates three-dimensional cell migration in Dictyostelium discoideum. It demonstrates that varying a single parameter, the protrusive strength of the activator, can generate different migration modes. The model successfully reproduces observed cell shapes and dynamics, suggesting a coupling between substrate properties and cell biomechanics. This work provides insights into the complex nature of cell migration and the potential for extending the model to more physiologically relevant scenarios.', p.paper_type = 'research_article', p.authors = 'Cao Y, Ghabache E, Miao Y, Niman C, Hakozaki H, Reck-Peterson SL, Devreotes PN, Rappel W-J';
