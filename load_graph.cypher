MERGE (pr:Protein {name: 'Smoothened'}) WITH pr MATCH (p:Paper {number: '258'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'Smoothened localizes with F-actin and is involved in Hedgehog signaling to regulate Tre1.'}]->(pr);
MERGE (pr:Protein {name: 'Hedgehog'}) WITH pr MATCH (p:Paper {number: '258'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'Hedgehog signaling through Smoothened increases Tre1 levels at the plasma membrane.'}]->(pr);
