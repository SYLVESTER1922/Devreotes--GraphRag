MERGE (p:Paper {number: '041'}) SET p.title = 'Phenotypic changes induced by a mutated ras gene during the development of Dictyostelium transformants', p.year = 1986, p.journal = 'Nature', p.doi = '', p.key_findings = 'The study found that mutations in the ras gene of Dictyostelium discoideum lead to significant phenotypic changes during development. Specifically, the ras-Gly 12 transformants exhibited normal aggregation behavior, while the ras-Thr 12 transformants formed abnormal aggregates with multiple tips and failed to fruit. These findings suggest that the GTPase activity of the ras protein is critical for proper cellular differentiation and development in Dictyostelium.', p.paper_type = 'letter', p.authors = 'Reymond, C.D., Gomer, R.H., Nellen, W., Theibert, A., Devreotes, P., Firtel, R.A.';
