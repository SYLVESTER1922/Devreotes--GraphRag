MERGE (p:Paper {number: '127'}) SET p.title = 'G Protein b Subunit–null Mutants Are Impaired in Phagocytosis and Chemotaxis Due to Inappropriate Regulation of the Actin Cytoskeleton', p.year = 1998, p.journal = 'The Journal of Cell Biology', p.doi = '', p.key_findings = 'The study demonstrates that deletion of the G protein b subunit in Dictyostelium discoideum leads to significant impairments in phagocytosis and chemotaxis due to inappropriate regulation of the actin cytoskeleton. The research shows that wild-type b subunit expression can restore phagocytic function, indicating its critical role in actin network remodeling. Additionally, the findings suggest that signaling through heterotrimeric G proteins is essential for actin polymerization during phagocytosis, highlighting the interconnectedness of chemotaxis and phagocytosis in amoeboid cells.', p.paper_type = 'research_article', p.authors = 'Peracino, B., Borleis, J., Jin, T., Westphal, M., Schwartz, J.-M., Wu, L., Bracco, E., Gerisch, G., Devreotes, P., Bozzaro, S.';
