MERGE (p:Paper {number: '152'}) SET p.title = 'Monitoring receptor-mediated activation of heterotrimeric G-proteins by fluorescence resonance energy transfer', p.year = 2002, p.journal = 'Methods', p.doi = '', p.key_findings = 'The study successfully demonstrated the use of FRET to monitor G-protein interactions in living Dictyostelium discoideum cells. By tagging the G-protein subunits Ga2 and Gbc with fluorescent proteins, the researchers were able to observe the dynamics of G-protein activation and dissociation upon receptor stimulation. This method provides a powerful tool for real-time analysis of G-protein signaling and has potential applications in drug screening and understanding receptor-ligand interactions.', p.paper_type = 'research_article', p.authors = 'Janetopoulos, C., Devreotes, P.';
