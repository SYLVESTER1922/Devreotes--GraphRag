MERGE (p:Paper {number: '140'}) SET p.title = 'Tortoise, a Novel Mitochondrial Protein, Is Required for Directional Responses of Dictyostelium in Chemotactic Gradients', p.year = 2001, p.journal = 'The Journal of Cell Biology', p.doi = '', p.key_findings = 'The study identifies Tortoise (TorA) as a novel mitochondrial protein essential for the directional chemotactic responses of Dictyostelium discoideum. Cells lacking TorA can sense chemoattractant gradients but fail to migrate directionally towards cAMP. Overexpression of Mek1 can partially restore chemotaxis in torA2 mutants, indicating a relationship between these proteins in the chemotactic pathway. The findings suggest a significant link between mitochondrial function and the chemotactic response, highlighting the importance of TorA in cellular movement and growth in suspension.', p.paper_type = 'research_article', p.authors = 'van Es, S., Wessels, D., Soll, D.R., Borleis, J., Devreotes, P.N.';
MERGE (pr:Protein {name: 'Tortoise (TorA)'}) WITH pr MATCH (p:Paper {number: '140'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'TorA is required for the efficient chemotaxis of Dictyostelium discoideum cells.'}]->(pr);
MERGE (pr:Protein {name: 'Mek1'}) WITH pr MATCH (p:Paper {number: '140'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'Mek1 is involved in the chemotactic pathway and its overexpression can partially restore chemotaxis in torA2 mutants.'}]->(pr);
