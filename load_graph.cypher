MERGE (pr:Protein {name: 'PKA regulatory subunit (Rm)'}) WITH pr MATCH (p:Paper {number: '124'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'The dominant negative Rm subunit inhibits PKA activation and affects prespore differentiation.'}]->(pr);
