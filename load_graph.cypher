MERGE (p:Paper {number: '126'}) SET p.title = 'Temperature-sensitive Gβ mutants discriminate between G protein-dependent and -independent signaling mediated by serpentine receptors', p.year = 1998, p.journal = 'The EMBO Journal', p.doi = '', p.key_findings = 'The study identifies that Gβ is essential for adenylyl cyclase A activation and morphogenetic signaling throughout Dictyostelium development. Temperature-sensitive Gβ mutants were used to demonstrate that Gβ is required for the induction of aggregative gene expression by cAMP pulses, while it is not necessary for prespore gene induction by DIF. The findings suggest that G protein-dependent and -independent signaling pathways may coexist in higher organisms, similar to those observed in Dictyostelium.', p.paper_type = 'research_article', p.authors = 'Jin, T., Soede, R.D.M., Liu, J., Kimmel, A.R., Devreotes, P.N., Schaap, P.';
