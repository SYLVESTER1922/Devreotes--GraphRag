MERGE (o:Organism {name: 'HEK293T cells'}) WITH o MATCH (p:Paper {number: '223'}) MERGE (p)-[:USES_ORGANISM {context: 'These human cells are used to study the effects of ePTEN on PIP3 signaling.'}]->(o);
MERGE (p:Paper {number: '064'}) SET p.title = 'G-protein-linked signal transduction systems control development in Dictyostelium', p.year = 1989, p.journal = 'Development', p.doi = '', p.key_findings = 'The study demonstrates that G-protein-linked cAMP receptors are essential for the development of Dictyostelium discoideum. Overexpression of the receptor leads to a significant increase in cAMP-binding sites, while antisense cell lines lacking the receptor fail to enter the developmental program. The research also highlights the role of ligand-induced phosphorylation in receptor function and the importance of G-proteins in mediating cAMP signaling during development.', p.paper_type = 'research_article', p.authors = 'Johnson, R.L., Gundersen, R., Lilly, P., Pitt, G.S., Pupillo, M., Sun, T.J., Vaughan, R.A., Devreotes, P.N.';
MERGE (pr:Protein {name: 'cAMP receptor'}) WITH pr MATCH (p:Paper {number: '064'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'G-protein-linked cAMP receptors play an essential role in Dictyostelium development.'}]->(pr);
