MERGE (p:Paper {number: '201'}) SET p.title = 'Cells navigate with a local-excitation, global-inhibition-biased excitable network', p.year = 2010, p.journal = 'Proceedings of the National Academy of Sciences', p.doi = '10.1073/pnas.1011271107', p.key_findings = 'The study proposes the LEGI-biased excitable network hypothesis to explain how cells navigate chemical gradients. It demonstrates that Ras and PI3K activation are synchronized with cytoskeletal events, leading to spontaneous activity and directed migration. The findings suggest that the biochemical network can adapt to stimuli and generate distinct behaviors consistent with known mutant classes. This work integrates diverse observations on cytoskeletal activity and signaling into a unified model of chemotaxis.', p.paper_type = 'research_article', p.authors = 'Xiong, Yuan, Huang, Chuan-Hsiang, Iglesias, Pablo A., Devreotes, Peter N.';
MERGE (pr:Protein {name: 'Ras'}) WITH pr MATCH (p:Paper {number: '201'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'Ras activation occurs spontaneously on pseudopodia during amoeboid cell migration.'}]->(pr);
