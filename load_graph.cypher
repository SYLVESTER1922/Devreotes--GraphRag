MERGE (p:Paper {number: '272'}) SET p.title = 'Complementary Cytoskeletal Feedback Loops Control Signal Transduction Excitability and Cell Polarity', p.year = 2024, p.journal = 'bioRxiv', p.doi = '10.1101/2024.02.13.580131', p.key_findings = 'The study identifies complementary feedback loops between the cytoskeleton and signaling networks that control cell polarity and migration. Increasing branched actin assembly enhances Ras/PI3K activation, while reducing myosin II assembly also boosts Ras activation. Conversely, inhibiting branched actin leads to increased cortical actin assembly and decreased Ras activation. These findings highlight the intricate interplay between cytoskeletal dynamics and signal transduction, crucial for cells navigating complex environments.', p.paper_type = 'research_article', p.authors = 'Kuhn, J., Banerjee, P., Haye, A., Robinson, D.N., Iglesias, P.A., Devreotes, P.N.';
