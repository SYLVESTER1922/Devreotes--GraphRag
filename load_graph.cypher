MERGE (m:Method {name: 'immunoblot'}) WITH m MATCH (p:Paper {number: '094'}) MERGE (p)-[:USES_METHOD {context: 'Immunoblot analyses were conducted to detect Ga8 protein levels.'}]->(m);
