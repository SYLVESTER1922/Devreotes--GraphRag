MERGE (p:Paper {number: '259'}) SET p.title = 'Three-dimensional stochastic simulation of chemoattractant-mediated excitability in cells', p.year = 2021, p.journal = 'PLOS Computational Biology', p.doi = '10.1371/journal.pcbi.1008803', p.key_findings = 'The study presents a new model that incorporates noise in the signaling mechanisms regulating cell motility. It demonstrates that the LEGI mechanism can adapt to varying stimuli while maintaining a balance between excitation and inhibition. The simulations recreate observed behaviors in both wild-type and perturbed cells, supporting the excitable system paradigm. This work highlights the importance of accurately modeling noise in understanding cell migration dynamics.', p.paper_type = 'research_article', p.authors = 'Biswas, D., Devreotes, P.N., Iglesias, P.A.';
