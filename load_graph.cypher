MERGE (c:Concept {name: 'membrane potential (Vm)'}) WITH c MATCH (p:Paper {number: '207'}) MERGE (p)-[:EXPLORES_CONCEPT {context: 'Changes in Vm are shown to significantly affect electrotaxis but not chemotaxis.'}]->(c);
