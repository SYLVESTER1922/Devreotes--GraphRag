MERGE (p:Paper {number: '210'}) SET p.title = 'Analysis of Chemotaxis in Dictyostelium', p.year = 2011, p.journal = 'Methods in Molecular Biology', p.doi = '10.1007/978-1-61779-166-6_26', p.key_findings = 'The chapter outlines methods to analyze chemotaxis in Dictyostelium discoideum, emphasizing the conservation of signaling mechanisms with human neutrophils. It describes the roles of various proteins, including cAMP receptors and G-proteins, in mediating cell movement and polarity. The use of advanced techniques like FRET and time-lapse microscopy allows for real-time observation of chemotactic responses, providing insights into the molecular mechanisms underlying directed cell migration.', p.paper_type = 'methods', p.authors = 'Huaqing Cai, Chuan-Hsiang Huang, Peter N. Devreotes, Miho Iijima';
