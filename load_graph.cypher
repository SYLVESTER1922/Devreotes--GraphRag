MERGE (p:Paper {number: '139'}) SET p.title = 'Cellular signaling and chemotaxis in Dictyostelium discoideum', p.year = 2023, p.journal = 'Journal of Cell Biology', p.doi = '10.1083/jcb.202301234', p.key_findings = 'The study elucidates the role of cAMP signaling in regulating chemotaxis in Dictyostelium discoideum. It highlights the importance of Ras and PI3K in the signaling cascade that leads to cell movement. The findings suggest that localized PIP3 production is critical for directional sensing and motility. This research provides insights into the molecular mechanisms underlying chemotaxis, which may have implications for understanding similar processes in higher organisms.', p.paper_type = 'research_article', p.authors = 'Devreotes, P.N., Zhao, X., Iijima, M., Kumagai, Y.';
