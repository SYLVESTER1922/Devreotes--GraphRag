MERGE (p:Paper {number: '275'}) SET p.title = 'Machine learning sparse reaction-diffusion models from stochastic dynamics and spatiotemporal patterns', p.year = 2024, p.journal = 'bioRxiv', p.doi = '10.1101/2024.10.02.616367', p.key_findings = 'The study introduces data-driven methodologies for learning the structure and parameters of spatial Langevin equation models from experimental data. It demonstrates that optimizing stochastic dynamics and wave patterns allows for accurate estimation of model parameters directly from spatiotemporal data. The approach effectively identifies novel sparse reaction-diffusion models for excitable systems, enhancing the understanding of complex cellular behaviors. This work represents a significant advancement in modeling dynamic biological processes using machine learning techniques.', p.paper_type = 'research_article', p.authors = 'Abubaker-Sharif, B., Devreotes, P.N., Iglesias, P.A.';
