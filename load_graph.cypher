MERGE (p:Paper {number: '221'}) SET p.title = 'Nucleocytoplasmic Shuttling of a GATA Transcription Factor Functions as a Development Timer', p.year = 2014, p.journal = 'Science', p.doi = '10.1126/science.1249531', p.key_findings = 'The study identifies GtaC as a key transcription factor that undergoes nucleocytoplasmic shuttling in response to periodic cAMP waves, which is essential for proper developmental timing. The oscillatory behavior of GtaC allows cells to modulate gene expression based on the frequency of cAMP stimuli rather than their concentration. This mechanism enables developmental synchronization across large populations of cells, highlighting the importance of temporal patterns in cellular responses to environmental signals.', p.paper_type = 'research_article', p.authors = 'Cai, H., Katoh-Kurasawa, M., Muramoto, T., Santhanam, B., Long, Y., Li, L., Ueda, M., Iglesias, P.A., Shaulsky, G., Devreotes, P.N.';
