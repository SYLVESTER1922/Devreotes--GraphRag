MERGE (m:Method {name: 'quantum yield measurement'}) WITH m MATCH (p:Paper {number: '212'}) MERGE (p)-[:USES_METHOD {context: 'Utilized to evaluate the optical efficiency of the quantum dots after lipid encapsulation.'}]->(m);
MERGE (m:Method {name: 'absorbance spectroscopy'}) WITH m MATCH (p:Paper {number: '212'}) MERGE (p)-[:USES_METHOD {context: 'Employed to determine the concentration and recovery of quantum dots during solubilization.'}]->(m);
