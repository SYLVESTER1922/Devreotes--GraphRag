MERGE (p:Paper {number: '180'}) SET p.title = 'Distinct Roles of PI(3,4,5)P3 during Chemoattractant Signaling in Dictyostelium: A Quantitative In Vivo Analysis by Inhibition of PI3-Kinase', p.year = 2006, p.journal = 'Molecular Biology of the Cell', p.doi = '10.1091/mbc.E05–09–0825', p.key_findings = 'The study demonstrates that severe inhibition of PI(3,4,5)P3 accumulation leads to reduced cell elongation and aggregation, but does not significantly affect chemotactic orientation towards cAMP. The results suggest that while PI(3,4,5)P3 is a strong regulator of pseudopod formation, its absence does not prevent effective chemotaxis if cells have sufficient time to elongate. Additionally, the research highlights the complex interplay between PI3-kinase activity, actin dynamics, and chemotactic signaling in Dictyostelium discoideum.', p.paper_type = 'research_article', p.authors = 'Loovers, H.M., Postma, M., Keizer-Gunnink, I., Huang, Y.E., Devreotes, P.N., van Haastert, P.J.M.';
