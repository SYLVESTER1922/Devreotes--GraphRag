MERGE (c:Concept {name: 'water solubilization'}) WITH c MATCH (p:Paper {number: '212'}) MERGE (p)-[:EXPLORES_CONCEPT {context: 'A critical process for transferring quantum dots from organic solvents to aqueous environments for biological use.'}]->(c);
MERGE (c:Concept {name: 'monodispersity'}) WITH c MATCH (p:Paper {number: '212'}) MERGE (p)-[:EXPLORES_CONCEPT {context: 'An important characteristic of quantum dot suspensions that was evaluated to ensure uniformity and prevent aggregation.'}]->(c);
MERGE (p:Paper {number: '035'}) SET p.title = 'The Specificity of the CAMP Receptor Mediating Activation of Adenylate Cyclase in Dictyostelium discoideum', p.year = 1986, p.journal = 'Developmental Biology', p.doi = '', p.key_findings = 'The study determined the specificity of the CAMP receptor in mediating the activation of adenylate cyclase and cyclic AMP secretion in Dictyostelium discoideum. It was found that various cyclic AMP analogs elicited similar responses in terms of chemotaxis and cGMP accumulation, indicating a high degree of correlation in receptor specificity. The results suggest that the receptor mediating these processes has a distinct specificity compared to phosphodiesterase and intracellular binding proteins.', p.paper_type = 'research_article', p.authors = 'Theibert, A., Palmisano, M., Jastorff, B., Devreotes, P.';
