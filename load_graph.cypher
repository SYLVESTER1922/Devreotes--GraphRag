MERGE (p:Paper {number: '247'}) SET p.title = 'Chemoattractant receptors activate, recruit and capture G proteins for wide range chemotaxis', p.year = 2018, p.journal = 'Biochemical and Biophysical Research Communications', p.doi = '10.1016/j.bbrc.2018.11.029', p.key_findings = 'The study reveals that cAR1-mediated activation, recruitment, and capturing of G proteins are crucial for chemotactic signaling across a wide range of cAMP concentrations. The research identifies distinct mechanisms of G protein dynamics that allow Dictyostelium cells to respond to varying ligand concentrations, thus extending their chemotactic range. Additionally, the formation of a complex between activated Ga2 and cAR1 is shown to enhance the retention of chemotactic signals, contributing to the overall understanding of gradient information production in chemotaxis.', p.paper_type = 'research_article', p.authors = 'Miyanaga, Yukihiro, Kamimura, Yoichiro, Kuwayama, Hidekazu, Devreotes, Peter N., Ueda, Masahiro';
