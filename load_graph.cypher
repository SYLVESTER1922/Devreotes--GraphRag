MERGE (p:Paper {number: '074'}) SET p.title = 'Overexpression of the cAMP Receptor 1 in Growing Dictyostelium Cells', p.year = 1991, p.journal = 'Biochemistry', p.doi = '', p.key_findings = 'The study demonstrates that overexpression of cAR1 in Dictyostelium discoideum during the growth stage leads to significantly increased levels of the receptor without drastically disrupting the developmental program. The expressed cAR1 retains similar binding affinity to cAMP as the endogenous receptors, but does not couple effectively to downstream signaling pathways, as evidenced by the lack of chemotaxis and cGMP elevation. This work provides a valuable system for further investigation of cAR1 regulatory functions and its role in the developmental processes of Dictyostelium.', p.paper_type = 'research_article', p.authors = 'Johnson, R.L., Vaughan, R.A., Caterina, M.J., Van Haastert, P.J.M., Devreotes, P.N.';
