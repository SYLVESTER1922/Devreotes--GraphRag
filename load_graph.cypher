MERGE (p:Paper {number: '156'}) SET p.title = 'Temporal and Spatial Regulation of Chemotaxis', p.year = 2002, p.journal = 'Developmental Cell', p.doi = '', p.key_findings = 'The review discusses the mechanisms of chemotaxis in Dictyostelium discoideum, highlighting the role of cAMP as a chemoattractant and the involvement of specific receptors (cAR1-cAR4) and G proteins in the signaling pathway. It emphasizes the importance of actin polymerization in cell motility and the dynamic localization of signaling molecules during chemotaxis. The findings suggest that understanding these processes in amoebae can provide insights into similar mechanisms in mammalian leukocytes.', p.paper_type = 'review', p.authors = 'Iijima, M., Huang, Y.E., Devreotes, P.N.';
