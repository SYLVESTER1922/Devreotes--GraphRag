MERGE (p:Paper {number: '039'}) SET p.title = 'A Molecular Mechanism for Sensory Adaptation Based on Ligand-Induced Receptor Modification', p.year = 1986, p.journal = 'Proceedings of the National Academy of Sciences of the United States of America', p.doi = '', p.key_findings = 'The study proposes a novel mechanism for sensory adaptation that involves ligand-induced receptor modification. It suggests that the various states of receptors, generated by ligand binding and covalent modification, regulate physiological responsiveness. The model accounts for both exact and partial adaptation, linking receptor modification to the control of adaptation without free parameters once rate constants are determined.', p.paper_type = 'research_article', p.authors = 'Knox, B.E., Devreotes, P.N., Goldbeter, A., Segel, L.A.';
