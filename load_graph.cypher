MERGE (p:Paper {number: '071'}) SET p.title = 'Expression of a cAMP receptor gene of Dictyostelium and evidence for a multigene family', p.year = 1991, p.journal = 'Genes & Development', p.doi = '10.1101/gad.5.1.1', p.key_findings = 'The study identifies CAR1 as a key cAMP receptor in Dictyostelium discoideum, showing that its expression peaks during early development when cAMP signaling is most active. The research also reveals the presence of a multigene family related to CAR1, suggesting that various receptor subtypes may mediate the diverse effects of cAMP. This work enhances the understanding of the molecular mechanisms underlying cell communication and development in Dictyostelium.', p.paper_type = 'research_article', p.authors = 'Saxe III, C.L., Johnson, R.L., Devreotes, P.N., Kimme, A.R.';
