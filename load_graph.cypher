MERGE (p:Paper {number: '174'}) SET p.title = 'Two Complementary, Local Excitation, Global Inhibition Mechanisms Acting in Parallel Can Explain the Chemoattractant-Induced Regulation of PI(3,4,5)P3 Response in Dictyostelium Cells', p.year = 2004, p.journal = 'Biophysical Journal', p.doi = '10.1529/biophysj.104.045484', p.key_findings = 'The study presents a model that explains how local excitation and global inhibition mechanisms regulate the response of Dictyostelium cells to chemoattractants. It highlights the roles of PI3K and PTEN in amplifying the PI(3,4,5)P3 response, demonstrating that these enzymes work in a complementary manner to enhance spatial resolution during chemotaxis. The model successfully predicts cellular responses to various chemoattractant stimuli and provides insights into the dynamics of signaling pathways involved in directional sensing.', p.paper_type = 'research_article', p.authors = 'Ma, L., Janetopoulos, C., Yang, L., Devreotes, P.N., Iglesias, P.A.';
