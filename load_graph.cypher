MERGE (p:Paper {number: '264'}) SET p.title = 'Nanotopography modulates intracellular excitable systems through cytoskeleton actuation', p.year = 2022, p.journal = 'bioRxiv', p.doi = '10.1101/2022.06.09.495528', p.key_findings = 'The study reveals that nanotopography is directly sensed by the cytoskeletal excitable network (CEN), while the signal-transduction excitable network (STEN) is indirectly affected through a feedback loop. It was found that CEN activity is enhanced on nanoridges, leading to persistent F-actin puncta, while STEN activity is constrained between ridges. The research highlights the importance of CEN in sensing physical cues and suggests that nanotopography can modulate cellular responses in complex environments.', p.paper_type = 'research_article', p.authors = 'Yang, Q., Miao, Y., Banerjee, P., Hourwitz, M.J., Hu, M., Qing, Q., Iglesias, P.A., Devreotes, P.N., Fourkas, J.T., Losert, W.';
