MERGE (c:Concept {name: 'adaptation'}) WITH c MATCH (p:Paper {number: '019'}) MERGE (p)-[:EXPLORES_CONCEPT {context: 'A reversible, time-dependent decrease in sensitivity to cAMP stimuli that regulates the magnitude and duration of signaling.'}]->(c);
MERGE (o:Organism {name: 'Dictyostelium discoideum NC-4'}) WITH o MATCH (p:Paper {number: '019'}) MERGE (p)-[:USES_ORGANISM {context: 'Used in all experiments to study the cAMP signaling response.'}]->(o);
MERGE (p:Paper {number: '087'}) SET p.title = 'The Surface Cyclic AMP Receptors, cAR1, cAR2, and cAR3, Promote Ca2+ Influx in Dictyostelium discoideum by a G2-Independent Mechanism', p.year = 1993, p.journal = 'Molecular Biology of the Cell', p.doi = '', p.key_findings = 'The study demonstrates that the surface cyclic AMP receptors cAR1, cAR2, and cAR3 can promote Ca2+ influx in Dictyostelium discoideum through a mechanism that is independent of G protein α subunits. The receptors were shown to activate a Ca2+-influx system that does not rely on G2 signaling, suggesting a novel pathway for Ca2+ entry during development. This finding highlights the complexity of signaling mechanisms in Dictyostelium and their potential parallels to higher eukaryotic systems.', p.paper_type = 'research_article', p.authors = 'Milne, J.L., Devreotes, P.N.';
