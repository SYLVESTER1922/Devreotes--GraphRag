MERGE (p:Paper {number: '032'}) SET p.title = 'Kinetics and Concentration Dependence of Reversible CAMP-induced Modification of the Surface cAMP Receptor in Dictyostelium', p.year = 1985, p.journal = 'The Journal of Biological Chemistry', p.doi = '', p.key_findings = 'The study demonstrates that extracellular cAMP induces a reversible shift in the electrophoretic mobility of the cAMP receptor in Dictyostelium. The kinetics of this modification show a half-time of 2.5 minutes for the transition to the lower mobility form, with a return to the basal state occurring over approximately 6 minutes. The findings suggest that the cAMP receptor undergoes significant modifications that may underlie the biochemical mechanisms of adaptation in response to persistent cAMP signaling.', p.paper_type = 'research_article', p.authors = 'Devreotes, P.N., Sherring, J.A.';
