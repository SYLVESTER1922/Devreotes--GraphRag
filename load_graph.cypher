MERGE (p:Paper {number: '068'}) SET p.title = 'Surface cAMP Receptors Mediate Multiple Responses during Development in Dictyostelium: Evidenced by Antisense Mutagenesis', p.year = 1990, p.journal = 'The Journal of Cell Biology', p.doi = '', p.key_findings = 'The study demonstrates that cAR1 is essential for the aggregation and differentiation of Dictyostelium discoideum. Antisense mutagenesis of cAR1 leads to a complete loss of cAMP binding activity and severely impairs the developmental program, preventing normal aggregation. The findings underscore the critical role of cAMP signaling in coordinating cellular responses during development.', p.paper_type = 'research_article', p.authors = 'Sun, Tzeli J., Van Haastert, Peter J. M., Devreotes, Peter N.';
