MERGE (p:Paper {number: '149'}) SET p.title = 'Single-Molecule Analysis of Chemotactic Signaling in Dictyostelium Cells', p.year = 2001, p.journal = 'Science', p.doi = '', p.key_findings = 'The study demonstrated that individual cAMP molecules bind to cAMP receptors on Dictyostelium discoideum cells, revealing the dynamic properties of these receptors during chemotaxis. The binding kinetics were influenced by G protein coupling, and the receptors exhibited lateral mobility in the plasma membrane. Additionally, differences in dissociation kinetics were observed between the anterior and posterior regions of the cells, suggesting intrinsic cell polarity in chemotactic signaling.', p.paper_type = 'research_article', p.authors = 'Masahiro Ueda, Yasushi Sako, Toshiki Tanaka, Peter Devreotes, Toshio Yanagida';
