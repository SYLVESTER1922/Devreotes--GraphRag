MERGE (p:Paper {number: '217'}) SET p.title = 'Interaction of Motility, Directional Sensing, and Polarity Modules Recreates the Behaviors of Chemotaxing Cells', p.year = 2013, p.journal = 'PLoS Computational Biology', p.doi = '10.1371/journal.pcbi.1003122', p.key_findings = 'The study presents a modular framework for understanding chemotaxis, integrating motility, directional sensing, and polarization. The model successfully simulates behaviors of chemotactic cells, including pseudopod splitting and responses to chemoattractant gradients. It demonstrates that the excitable network can recreate the signaling dynamics observed in real cells, providing insights into the underlying mechanisms of chemotaxis.', p.paper_type = 'research_article', p.authors = 'Shi, Changji, Huang, Chuan-Hsiang, Devreotes, Peter N., Iglesias, Pablo A.';
