MERGE (p:Paper {number: '240'}) SET p.title = 'Assessment of Dictyostelium discoideum Response to Acute Mechanical Stimulation', p.year = 2017, p.journal = 'Journal of Visualized Experiments', p.doi = '10.3791/56411', p.key_findings = 'The study developed a method to assess the response of Dictyostelium discoideum to acute mechanical stimulation via shear flow. It was found that this stimulation activates components of the chemotactic signal transduction and actin cytoskeleton networks. The findings suggest that mechanical stimuli share signaling pathways with chemical stimuli, allowing for integration in cell migration. This approach provides insights into the mechanisms of directed migration beyond traditional chemoattractant responses.', p.paper_type = 'research_article', p.authors = 'Artemenko, Y., Devreotes, P.N.';
