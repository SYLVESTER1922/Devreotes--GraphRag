MERGE (p:Paper {number: '214'}) SET p.title = '3D Arrays for High Throughput Assay of Cell Migration and Electrotaxis', p.year = 2013, p.journal = 'Cell Biology International', p.doi = '10.1002/cbin.10116', p.key_findings = 'The study presents a novel 3D array technique that allows for high throughput screening of cell behavior in response to electric fields. Dictyostelium discoideum cells were shown to migrate towards the cathode in 3D agarose matrices under direct current electric fields. The migration rates of these cells were significantly affected by the concentration of agarose, with higher concentrations leading to reduced motility. This method provides a powerful tool for evaluating the effects of various 3D environments on cell behavior.', p.paper_type = 'research_article', p.authors = 'Zhao, S., Gao, R., Devreotes, P.N., Mogilner, A., Zhao, M.';
