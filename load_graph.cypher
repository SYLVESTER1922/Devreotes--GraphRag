MERGE (p:Paper {number: '114'}) SET p.title = 'Constitutively Active Adenylyl Cyclase Mutant Requires Neither G Proteins nor Cytosolic Regulators', p.year = 1996, p.journal = 'THE JOURNAL OF BIOLOGICAL CHEMISTRY', p.doi = '', p.key_findings = 'The study reports the isolation of a constitutively active mutant of adenylyl cyclase (ACA) that does not require G proteins or cytosolic regulators for activation. This mutant, identified as C3, exhibits a 15-fold increase in Vmax compared to wild type ACA and maintains high activity even in the absence of G protein bg-subunits. The findings suggest that mutations in the catalytic subunit of adenylyl cyclase could contribute to certain genetic disorders, highlighting the importance of ACA in cellular signaling and development in Dictyostelium.', p.paper_type = 'research_article', p.authors = 'Parent, C.A., Devreotes, P.N.';
