MERGE (p:Paper {number: '119'}) SET p.title = 'The Dictyostelium Mitogen-activated Protein Kinase ERK2 Is Regulated by Ras and cAMP-dependent Protein Kinase (PKA) and Mediates PKA Function', p.year = 1997, p.journal = 'The Journal of Biological Chemistry', p.doi = '', p.key_findings = 'The study demonstrates that ERK2 is activated by cAMP and regulated by Ras and PKA during Dictyostelium aggregation. Ras acts as a negative regulator of ERK2, while PKA positively influences its activation. The research highlights the importance of the Aimless Ras GEF and CRAC in the signaling pathways that control ERK2 activity. Overall, the findings suggest a complex interplay between these components in mediating cellular responses to cAMP signaling.', p.paper_type = 'research_article', p.authors = 'Aubry, L., Maeda, M., Insall, R., Devreotes, P.N., Firtel, R.A.';
