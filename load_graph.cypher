MERGE (p:Paper {number: '190'}) SET p.title = 'G protein–independent Ras/PI3K/F-actin circuit regulates basic cell motility', p.year = 2007, p.journal = 'The Journal of Cell Biology', p.doi = '10.1083/jcb.200611138', p.key_findings = 'The study reveals that PI3K and Ras can be activated independently of G protein signaling in Dictyostelium cells, leading to spontaneous accumulation of PI(3,4,5)P3 at sites of F-actin projection. This Gβ-independent activation of PI3K and Ras occurs in the absence of extracellular stimuli and is crucial for random cell migration and cytokinesis. The findings suggest a core regulatory pathway that may control various physiological responses, including chemotaxis and phagocytosis.', p.paper_type = 'research_article', p.authors = 'Sasaki, A.T., Janetopoulos, C., Lee, S., Charest, P.G., Takeda, K., Sundheimer, L.W., Meili, R., Devreotes, P.N., Firtel, R.A.';
