MERGE (p:Paper {number: '268'}) SET p.title = 'The Effects of Statins in Patients with Advanced-Stage Cancers -A Systematic Review and Meta-Analysis', p.year = 2023, p.journal = 'Frontiers in Oncology', p.doi = '', p.key_findings = 'Statin therapy was associated with a 26% decreased risk of overall survival and cancer-specific survival, and a 24% decreased risk of progression-free survival in advanced-stage cancer patients. The benefits of statin therapy, while significant, may be lower than those of approved immunotherapy medications. The cost-effectiveness of statins could lead to dramatic health consequences, suggesting that their concomitant use as cancer treatments should be highly recommended in future clinical trials.', p.paper_type = 'research_article', p.authors = 'Zhou, Q., Jiao, Z., Liu, Y., Devreotes, P.N., Zhang, Z.';
