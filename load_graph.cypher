MERGE (p:Paper {number: '181'}) SET p.title = 'Navigating signaling networks: chemotaxis in Dictyostelium discoideum', p.year = 2006, p.journal = 'Current Opinion in Genetics & Development', p.doi = '10.1016/j.gde.2006.06.001', p.key_findings = 'The review discusses the complex signaling networks involved in chemotaxis in Dictyostelium discoideum, highlighting the roles of various proteins such as PI3K, PTEN, and Ras in directional sensing and pseudopod extension. It emphasizes the importance of PIP3 accumulation at the leading edge for effective chemotaxis and suggests that alternative pathways may also contribute to directional sensing. The findings underscore the significance of understanding these mechanisms for insights into broader biological processes and diseases.', p.paper_type = 'review', p.authors = 'Franca-Koh, J., Kamimura, Y., Devreotes, P.';
MERGE (pr:Protein {name: 'phosphatidylinositol 3-kinase'}) WITH pr MATCH (p:Paper {number: '181'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'PI3K produces PIP3 by phosphorylating PIP2, which is crucial for directional sensing.'}]->(pr);
MERGE (pr:Protein {name: 'PTEN'}) WITH pr MATCH (p:Paper {number: '181'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'PTEN catalyzes the reverse reaction of PI3K, regulating PIP3 levels and localization.'}]->(pr);
MERGE (pr:Protein {name: 'Ras'}) WITH pr MATCH (p:Paper {number: '181'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'Ras is activated at the leading edge of the cell in response to chemoattractants.'}]->(pr);
MERGE (pr:Protein {name: 'protein kinase B'}) WITH pr MATCH (p:Paper {number: '181'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'PKB is recruited to the front of D. discoideum cells and is important for actin polymerization.'}]->(pr);
MERGE (pr:Protein {name: 'calcium-independent phospholipase A2'}) WITH pr MATCH (p:Paper {number: '181'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'This enzyme may be part of an alternative directional sensing pathway.'}]->(pr);
MERGE (pr:Protein {name: 'myosin II'}) WITH pr MATCH (p:Paper {number: '181'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'Myosin II is assembled into contractile filaments that suppress pseudopod formation at the back of the cell.'}]->(pr);
MERGE (pr:Protein {name: 'PakA'}) WITH pr MATCH (p:Paper {number: '181'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'PakA promotes the assembly and activity of myosin II.'}]->(pr);
MERGE (pr:Protein {name: 'GbpC'}) WITH pr MATCH (p:Paper {number: '181'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'GbpC is a cGMP binding protein that promotes myosin II activity.'}]->(pr);
MERGE (pr:Protein {name: 'CRAC'}) WITH pr MATCH (p:Paper {number: '181'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'CRAC is a PH domain-containing protein that localizes to the leading edge and is required for efficient chemotaxis.'}]->(pr);
MERGE (pr:Protein {name: 'PhdA'}) WITH pr MATCH (p:Paper {number: '181'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'PhdA is another PH domain protein that localizes to the leading edge and is necessary for chemotaxis.'}]->(pr);
MERGE (pr:Protein {name: 'WASP'}) WITH pr MATCH (p:Paper {number: '181'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'WASP is a regulator of the Arp2–Arp3 complex involved in actin polymerization.'}]->(pr);
MERGE (pr:Protein {name: 'Scar'}) WITH pr MATCH (p:Paper {number: '181'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'Scar is part of a multiprotein complex that regulates actin polymerization in D. discoideum.'}]->(pr);
MERGE (pr:Protein {name: 'RacB'}) WITH pr MATCH (p:Paper {number: '181'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'RacB is activated by RacGEF1, which localizes at the front of cells.'}]->(pr);
MERGE (m:Method {name: 'total internal reflection microscopy'}) WITH m MATCH (p:Paper {number: '181'}) MERGE (p)-[:USES_METHOD {context: 'This technique was used to study the dynamics of PTEN binding to the plasma membrane.'}]->(m);
MERGE (c:Concept {name: 'chemotaxis'}) WITH c MATCH (p:Paper {number: '181'}) MERGE (p)-[:EXPLORES_CONCEPT {context: 'Chemotaxis is the directed migration of cells in gradients of signaling molecules, crucial for various biological processes.'}]->(c);
MERGE (c:Concept {name: 'directional sensing'}) WITH c MATCH (p:Paper {number: '181'}) MERGE (p)-[:EXPLORES_CONCEPT {context: 'Directional sensing is the ability of cells to determine the direction of a concentration gradient.'}]->(c);
MERGE (c:Concept {name: 'pseudopod extension'}) WITH c MATCH (p:Paper {number: '181'}) MERGE (p)-[:EXPLORES_CONCEPT {context: 'Pseudopod extension is driven by actin polymerization and is essential for cell motility.'}]->(c);
MERGE (c:Concept {name: 'polarization'}) WITH c MATCH (p:Paper {number: '181'}) MERGE (p)-[:EXPLORES_CONCEPT {context: 'Polarization involves stable changes in cell morphology and protein localization that enhance migration.'}]->(c);
MERGE (o:Organism {name: 'Dictyostelium discoideum'}) WITH o MATCH (p:Paper {number: '181'}) MERGE (p)-[:USES_ORGANISM {context: 'This social amoeba is a model organism for studying chemotaxis due to its well-conserved signaling pathways.'}]->(o);
MERGE (p:Paper {number: '205'}) SET p.title = 'Disrupting microtubule network immobilizes amoeboid chemotactic receptor in the plasma membrane', p.year = 2011, p.journal = 'Biochimica et Biophysica Acta', p.doi = '10.1016/j.bbamem.2011.02.009', p.key_findings = 'The study reveals that cAR1, a G-protein coupled receptor, exhibits directed motion in the plasma membrane of Dictyostelium discoideum, which is regulated by the microtubule network. Disruption of microtubules immobilizes cAR1, affecting its ability to interact with downstream signaling partners. This suggests that microtubules play a crucial role in the dynamics of cAR1 and, consequently, in the chemotactic response of the cells.', p.paper_type = 'research_article', p.authors = 'de Keijzer, S., Galloway, J., Harms, G.S., Devreotes, P.N., Iglesias, P.A.';
MERGE (pr:Protein {name: 'cAMP receptor 1'}) WITH pr MATCH (p:Paper {number: '205'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'cAR1 is a G-protein coupled receptor that mediates chemotactic responses in Dictyostelium discoideum.'}]->(pr);
MERGE (pr:Protein {name: 'PH domain of CRAC'}) WITH pr MATCH (p:Paper {number: '205'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'The jump of the PH domain of CRAC was decreased due to microtubule stabilization.'}]->(pr);
MERGE (pr:Protein {name: 'HaloTag™ protein'}) WITH pr MATCH (p:Paper {number: '205'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'The gene encoding HaloTag™ protein was fused to the COOH-terminal of cAR1 for labeling.'}]->(pr);
MERGE (pr:Protein {name: 'γ-Tubulin-GFP'}) WITH pr MATCH (p:Paper {number: '205'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'This protein was transformed into AX2 cells to study microtubule dynamics.'}]->(pr);
MERGE (pr:Protein {name: 'Tetramethylrhodamine'}) WITH pr MATCH (p:Paper {number: '205'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'TMR was used to label the HaloTag™ protein for single-molecule tracking.'}]->(pr);
MERGE (m:Method {name: 'Total Internal Reflection Microscopy'}) WITH m MATCH (p:Paper {number: '205'}) MERGE (p)-[:USES_METHOD {context: 'This technique was used for single-particle tracking of fluorescently labeled cAR1.'}]->(m);
MERGE (m:Method {name: 'Fluorescence Recovery after Photobleaching'}) WITH m MATCH (p:Paper {number: '205'}) MERGE (p)-[:USES_METHOD {context: 'FRAP was used to confirm the mobility of cAR1 in the plasma membrane.'}]->(m);
MERGE (m:Method {name: 'Fusion PCR technique'}) WITH m MATCH (p:Paper {number: '205'}) MERGE (p)-[:USES_METHOD {context: 'This method was used to create the cAR1-Halo fusion construct.'}]->(m);
