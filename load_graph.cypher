MERGE (p:Paper {number: '079'}) SET p.title = 'cAMP-Induced Desensitization of Surface cAMP Receptors in Dictyostelium: Different Second Messengers Mediate Receptor Phosphorylation, Loss of Ligand Binding, Degradation of Receptor, and Reduction of Receptor mRNA Levels', p.year = 1992, p.journal = 'Molecular Biology of the Cell', p.doi = '', p.key_findings = 'The study reveals that cAMP-induced desensitization of surface cAMP receptors in Dictyostelium involves multiple mechanisms, including loss of ligand binding, receptor phosphorylation, and degradation. Notably, loss of ligand binding can occur independently of receptor phosphorylation, while receptor degradation requires the activation of specific second messenger systems. Additionally, the decrease in receptor mRNA levels is dependent on the activation of the fgdC gene product. These findings highlight the complexity of receptor desensitization and its regulation by overlapping signaling pathways.', p.paper_type = 'research_article', p.authors = 'Van Haastert, P.J.M., Wang, M., Bominaar, A.A., Devreotes, P.N., Schaap, P.';
