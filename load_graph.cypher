MERGE (p:Paper {number: '024'}) SET p.title = 'Quantitative Analysis of Cyclic AMP Waves Mediating Aggregation in Dictyostelium discoideum', p.year = 1983, p.journal = 'Developmental Biology', p.doi = '', p.key_findings = 'The study quantitatively analyzes the characteristics of CAMP waves in Dictyostelium discoideum, revealing that these waves have consistent dimensions and oscillate in concentration. Cells are stimulated to move in response to increasing CAMP levels, and the interaction of opposing waves enhances cellular responses. The findings provide insights into the biochemical mechanisms underlying cellular movements during aggregation.', p.paper_type = 'research_article', p.authors = 'Devreotes, P.N., Pott, M.J., Mackay, S.A.';
