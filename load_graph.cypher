MERGE (p:Paper {number: '108'}) SET p.title = 'Signaling through chemoattractant receptors in Dictyostelium', p.year = 1996, p.journal = 'Trends in Genetics', p.doi = '', p.key_findings = 'The study elucidates the role of various cAMP receptors (cAR1-4) and G-protein subunits (Gα1-8, Gβ) in mediating chemotactic responses in Dictyostelium discoideum. It highlights the complexity of the signaling pathways involved in chemotaxis and the importance of genetic analysis in identifying essential components. The findings suggest that the mechanisms of chemotaxis in Dictyostelium may be conserved across eukaryotic cells, providing insights into the fundamental processes of cell migration.', p.paper_type = 'research_article', p.authors = 'Chen, M.Y., Insall, R.H., Devroetes, P.N.';
