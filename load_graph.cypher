MERGE (p:Paper {number: '002'}) SET p.title = 'ACETYLCHOLINE RECEPTOR TURNOVER IN MEMBRANES OF DEVELOPING MUSCLE FIBERS', p.year = 1975, p.journal = 'THE JOURNAL OF CELL BIOLOGY', p.doi = '', p.key_findings = 'The study concludes that acetylcholine receptors in the surface membranes of chick and rat myotubes have a half-life of 22-24 hours. It was observed that α-bungarotoxin-receptor complexes are internalized and degraded, with degradation not coupled to receptor incorporation into the membrane. Additionally, two functionally different pools of acetylcholine receptors were identified, including a set of \'hidden\' receptors that are not readily accessible for binding. These findings provide insights into the mechanisms of receptor turnover and the regulation of muscle cell sensitivity to acetylcholine.', p.paper_type = 'research_article', p.authors = 'DEVREOTES, P.N., FAMBROUGH, D.M.';
