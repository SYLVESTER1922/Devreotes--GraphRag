MERGE (p:Paper {number: '185'}) SET p.title = 'Signaling pathways mediating chemotaxis in the social amoeba, Dictyostelium discoideum', p.year = 2006, p.journal = 'European Journal of Cell Biology', p.doi = '10.1016/j.ejcb.2006.06.003', p.key_findings = 'The paper discusses the molecular mechanisms underlying chemotaxis in Dictyostelium discoideum, emphasizing the roles of phosphoinositide signaling and G-protein-coupled receptors. It highlights the importance of PI(3,4,5)P3 in directional sensing and actin polymerization, as well as the critical functions of various proteins such as PTEN and PI3K in regulating these processes. The findings contribute to a better understanding of chemotaxis, which is essential for various biological processes and has implications for treating diseases related to cell migration.', p.paper_type = 'review', p.authors = 'Willard, S.S., Devreotes, P.N.';
