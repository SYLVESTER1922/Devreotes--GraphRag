MERGE (pr:Protein {name: 'Akt'}) WITH pr MATCH (p:Paper {number: '183'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'Electric fields activate Akt on Ser 473 in primary cultures of mouse keratinocyte and mouse peritoneal neutrophils.'}]->(pr);
