MERGE (c:Concept {name: 'chemotaxis'}) WITH c MATCH (p:Paper {number: '073'}) MERGE (p)-[:EXPLORES_CONCEPT {context: 'The study investigates the role of cAR1 in chemotaxis during the development of Dictyostelium.'}]->(c);
MERGE (c:Concept {name: 'signal transduction'}) WITH c MATCH (p:Paper {number: '073'}) MERGE (p)-[:EXPLORES_CONCEPT {context: 'cAR1-mediated signal transduction is crucial for the developmental processes in Dictyostelium.'}]->(c);
MERGE (c:Concept {name: 'cAMP oscillations'}) WITH c MATCH (p:Paper {number: '073'}) MERGE (p)-[:EXPLORES_CONCEPT {context: 'cAMP oscillations are necessary for the expression of genes during the aggregation stage of Dictyostelium development.'}]->(c);
