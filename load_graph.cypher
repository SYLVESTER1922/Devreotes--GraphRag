MERGE (p:Paper {number: '027'}) SET p.title = 'Adenosine and its Derivatives Inhibit the CAMP Signaling Response in Dictyostelium discoideum', p.year = 1984, p.journal = 'Developmental Biology', p.doi = '', p.key_findings = 'Adenosine and its derivatives, such as 2\'-O-methyladenosine and 2-chloroadenosine, were found to inhibit the CAMP signaling response in Dictyostelium discoideum. The inhibition was rapid, reversible, and dependent on both the concentration of adenosine and the CAMP stimulus. The study provides insights into the mechanisms by which adenosine affects cellular processes such as chemotaxis and center formation during development.', p.paper_type = 'research_article', p.authors = 'Theibert, A., Devreotes, P.N.';
