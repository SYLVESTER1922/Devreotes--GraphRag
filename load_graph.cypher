MERGE (p:Paper {number: '076'}) SET p.title = 'Dictyostelium transiently expresses eight distinct G-protein α-subunits during its developmental program', p.year = 1991, p.journal = 'Biochemical and Biophysical Research Communications', p.doi = '', p.key_findings = 'The study identifies three novel G-protein α-subunits (Gα6, Gα7, and Gα8) in Dictyostelium discoideum, expanding the known diversity of G-proteins in this organism. The expression patterns of these subunits suggest distinct roles in the developmental program, with Gα6 primarily expressed in vegetative cells and Gα8 correlating with adenylate cyclase activity. This research highlights the complexity of G-protein signaling in a model organism for studying cellular communication and development.', p.paper_type = 'research_article', p.authors = 'Wu, L., Devreotes, P.N.';
