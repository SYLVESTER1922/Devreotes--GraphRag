MERGE (p:Paper {number: '046'}) SET p.title = 'Chemoattractant-elicited Increases in Dictyostelium Myosin Phosphorylation Are Due to Changes in Myosin Localization and Increases in Kinase Activity', p.year = 1987, p.journal = 'The Journal of Biological Chemistry', p.doi = '', p.key_findings = 'The study demonstrates that cAMP stimulation leads to transient increases in myosin heavy and light chain phosphorylation in Dictyostelium discoideum. The phosphorylation of the heavy chain is primarily on threonine, while the light chain is phosphorylated on serine. The findings suggest that myosin kinase activity is crucial for regulating these phosphorylation changes, which are linked to cell motility and shape changes in response to chemotactic signals.', p.paper_type = 'research_article', p.authors = 'Berlot, C.H., Devreotes, P.N., Spudich, J.A.';
