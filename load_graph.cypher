MERGE (p:Paper {number: '212'}) SET p.title = 'Quantitative Characterization of the Lipid Encapsulation of Quantum Dots for Biomedical Applications', p.year = 2012, p.journal = 'Nanomedicine', p.doi = '10.1016/j.nano.2011.12.002', p.key_findings = 'The study systematically evaluated the water solubilization of quantum dots (QDs) using lipid encapsulation, demonstrating that charged surfactants and pegylated lipids are crucial for achieving monodisperse suspensions with high quantum yield and stability. The research highlights the effectiveness of various lipid compositions, including single and double acyl chain lipids, in enhancing the physicochemical properties of QDs for biomedical applications. These findings provide a foundation for the design of lipid-coated QDs that can be utilized in a wide range of biological settings.', p.paper_type = 'research_article', p.authors = 'Galloway, J.F., Winter, A., Lee, K.H., Park, J., Dvoracek, C., Devreotes, P., Searson, P.C.';
