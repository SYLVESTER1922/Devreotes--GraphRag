MERGE (p:Paper {number: '111'}) SET p.title = 'The aimless RasGEF is required for processing of chemotactic signals through G-protein-coupled receptors in Dictyostelium', p.year = 1996, p.journal = 'Current Biology', p.doi = '', p.key_findings = 'The aimless gene is essential for the processing of chemotactic signals in Dictyostelium, as aimless null mutants exhibit severe impairments in chemotaxis and adenylyl cyclase activation. Although the coupling between receptors and G proteins remains unaffected, the activation of adenylyl cyclase is significantly reduced in these mutants. This study highlights the unexpected role of a RasGEF in chemotactic signaling pathways, suggesting a broader function for Ras pathways in cellular movement and response to environmental cues.', p.paper_type = 'research_article', p.authors = 'Insall, R.H., Borleis, J., Devreotes, P.N.';
