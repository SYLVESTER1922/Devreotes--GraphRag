MERGE (pr:Protein {name: 'constitutively active adenylyl cyclase (ACG)'}) WITH pr MATCH (p:Paper {number: '124'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'ACG can complement cells lacking ACA but does not restore aggregation in pkacat0 cells.'}]->(pr);
