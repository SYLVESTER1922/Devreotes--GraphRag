MERGE (p:Paper {number: '170'}) SET p.title = 'Visualization of G Protein 𝛼𝛽 Dimers Using Bimolecular Fluorescence Complementation Demonstrates Roles for Both 𝛼 and 𝛽 in Subcellular Targeting', p.year = 2004, p.journal = 'The Journal of Biological Chemistry', p.doi = '10.1074/jbc.M401432200', p.key_findings = 'The study demonstrates that bimolecular fluorescence complementation can effectively visualize G protein 𝛼𝛽 dimers in living cells. It was found that different combinations of 𝛼 and 𝛽 subunits exhibit distinct localization patterns, with 𝛼1 and 𝛼2 localizing to the plasma membrane while 𝛼5 accumulates in the cytosol. This indicates that the 𝛼 subunit plays a critical role in directing the trafficking of the 𝛽 subunit, highlighting the importance of specific 𝛼𝛽 combinations in G protein signaling specificity.', p.paper_type = 'research_article', p.authors = 'Hynes, T.R., Tang, L., Mervine, S.M., Sabo, J.L., Yost, E.A., Devreotes, P.N., Berlot, C.H.';
