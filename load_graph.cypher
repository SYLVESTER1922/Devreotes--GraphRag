MERGE (p:Paper {number: '157'}) SET p.title = 'Temperature-Sensitive Inhibition of Development in Dictyostelium Due to a Point Mutation in the piaA Gene', p.year = 2002, p.journal = 'Developmental Biology', p.doi = '10.1006/dbio.2002.0809', p.key_findings = 'The HSB1 mutant of Dictyostelium discoideum is temperature-sensitive for development, failing to aggregate at temperatures above 18°C. The defect is linked to a point mutation in the piaA gene, resulting in a G917D amino acid substitution. Transfection with the wild-type piaA gene rescues the mutant phenotype, indicating the critical role of PIA in coupling G proteins to adenylyl cyclase. The study highlights the importance of PIA in the cAMP signaling pathway during Dictyostelium development.', p.paper_type = 'research_article', p.authors = 'Pergolizzi, B., Peracino, B., Silverman, J., Ceccarelli, A., Noegel, A., Devreotes, P., Bozzaro, S.';
