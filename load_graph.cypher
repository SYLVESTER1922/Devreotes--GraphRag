MERGE (p:Paper {number: '267'}) SET p.title = 'Optogenetic modulation of guanine nucleotide exchange factors of Ras superfamily proteins directly controls cell shape and movement', p.year = 2023, p.journal = 'Frontiers in Cell and Developmental Biology', p.doi = '10.3389/fcell.2023.1195806', p.key_findings = 'The study demonstrates that optogenetic modulation of guanine nucleotide exchange factors (GEFs) can rapidly control cell shape and movement. By recruiting GEFs to the plasma membrane using light, the researchers observed significant changes in F-actin rich protrusions and cell size. This approach allows for precise spatial and temporal control of signaling pathways, providing insights into the roles of GEFs in directed cell migration. The findings suggest that this optogenetic toolbox can be applied to various physiological contexts, including embryogenesis and cancer metastasis.', p.paper_type = 'methods', p.authors = 'Pal, D.S., Lin, Y., Zhan, H., Banerjee, T., Kuhn, J., Providence, S., Devreotes, P.N.';
