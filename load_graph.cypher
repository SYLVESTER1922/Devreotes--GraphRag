MERGE (p:Paper {number: '034'}) SET p.title = 'A Mechanism for Exact Sensory Adaptation Based on Receptor Modification', p.year = 1986, p.journal = 'Journal of Theoretical Biology', p.doi = '', p.key_findings = 'The paper presents a theoretical model for sensory adaptation based on receptor modification, showing that a linear combination of receptor states can achieve exact adaptation to step increases in stimuli. It highlights the role of receptor states in generating physiological responses and discusses the implications for cAMP signaling in Dictyostelium discoideum and chemotaxis in bacteria. The findings suggest that adaptation mechanisms are crucial for maintaining homeostasis in sensory systems.', p.paper_type = 'research_article', p.authors = 'SEGEL, L.A., GOLDBETER, A., DEVREOTES, P.N., KNOX, B.E.';
