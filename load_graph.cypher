MERGE (p:Paper {number: '093'}) SET p.title = 'Identification of CRAC, a Cytosolic Regulator Required for Guanine Nucleotide Stimulation of Adenylyl Cyclase in Dictyostelium', p.year = 1994, p.journal = 'The Journal of Biological Chemistry', p.doi = '', p.key_findings = 'The study identifies CRAC as a cytosolic regulator essential for the stimulation of adenylyl cyclase by guanine nucleotides in Dictyostelium discoideum. The purification process revealed an 88-kDa protein that is absent in the synag 7 mutant but present in wild-type cells. The expression of the dagA cDNA in synag 7 cells restored both the 88 kDa band and CRAC activity, suggesting a direct link between CRAC and the regulation of adenylyl cyclase. These findings highlight the evolutionary conservation of signaling mechanisms between Dictyostelium and mammalian systems.', p.paper_type = 'research_article', p.authors = 'Lilly, P.J., Devreotes, P.N.';
