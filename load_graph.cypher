MERGE (p:Paper {number: '198'}) SET p.title = 'Eukaryotic Chemotaxis: A Network of Signaling Pathways Controls Motility, Directional Sensing, and Polarity', p.year = 2010, p.journal = 'Annual Review of Biophysics', p.doi = '10.1146/annurev.biophys.093008.131228', p.key_findings = 'The review discusses the complex network of signaling pathways that control chemotaxis in eukaryotic cells, particularly focusing on Dictyostelium. It highlights the roles of various proteins, such as G-proteins, PIP3, and Myosin II, in mediating motility, directional sensing, and polarity. The findings emphasize the evolutionary conservation of these signaling mechanisms across different cell types, underscoring their importance in physiological processes and disease states.', p.paper_type = 'review', p.authors = 'Swaney, K.F., Huang, C.-H., Devreotes, P.N.';
