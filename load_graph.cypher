MERGE (pr:Protein {name: 'Gα2'}) WITH pr MATCH (p:Paper {number: '073'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'Gα2 protein is coupled to cAR1 and is essential for cAMP-mediated responses.'}]->(pr);
