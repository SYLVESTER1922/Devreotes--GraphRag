MERGE (p:Paper {number: '012'}) SET p.title = 'The Life History of Acetylcholine Receptors', p.year = 1978, p.journal = 'J. Cell Biol.', p.doi = '', p.key_findings = 'The study provides insights into the life history of acetylcholine receptors, detailing their biosynthesis, processing, and degradation. It highlights the role of the Golgi apparatus in receptor assembly and the impact of inhibitors on receptor incorporation into the plasma membrane. Additionally, it discusses the effects of denervation on receptor biosynthesis and the mechanisms regulating receptor metabolism in muscle cells.', p.paper_type = 'research_article', p.authors = 'Fambrough, D.M., Devreotes, P.N., Gardner, J.M., Card, D.J.';
