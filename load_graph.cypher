MERGE (p:Paper {number: '098'}) SET p.title = 'Serine 113 Is the Site of Receptor-mediated Phosphorylation of the Dictyostelium G Protein α-Subunit Ga2', p.year = 1994, p.journal = 'The Journal of Biological Chemistry', p.doi = '', p.key_findings = 'The study identifies serine 113 as the specific site of receptor-mediated phosphorylation on the G protein α-subunit Ga2 in Dictyostelium. This phosphorylation is crucial for the protein\'s function in developmental processes such as aggregation and differentiation. The research highlights the importance of Ga2 in G protein signaling pathways, particularly in response to cAMP, and suggests that phosphorylation may represent an additional regulatory mechanism in G protein activation.', p.paper_type = 'research_article', p.authors = 'Chen, Mei-Yu, Devreotes, Peter N., Gundersen, Robert E.';
