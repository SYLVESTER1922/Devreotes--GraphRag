MERGE (o:Organism {name: 'Dictyostelium discoideum'}) WITH o MATCH (p:Paper {number: '193'}) MERGE (p)-[:USES_ORGANISM {context: 'Dictyostelium discoideum was used as a model organism to study chemotaxis and cell polarization.'}]->(o);
MERGE (p:Paper {number: '192'}) SET p.title = 'PIP3-Independent Activation of TorC2 and PKB at the Cell’s Leading Edge Mediates Chemotaxis', p.year = 2008, p.journal = 'Current Biology', p.doi = '10.1016/j.cub.2008.06.068', p.key_findings = 'The study reveals a PIP3-independent pathway for chemotaxis in Dictyostelium discoideum, where TorC2 activates PKB homologs PKBA and PKBR1 at the leading edge. This activation leads to the phosphorylation of several substrates, including Talin B and Ras GEFs, which are crucial for cytoskeletal rearrangements and directed migration. The findings suggest that multiple signaling pathways, including those independent of PIP3, contribute to the regulation of chemotaxis.', p.paper_type = 'research_article', p.authors = 'Kamimura, Y., Xiong, Y., Iglesias, P.A., Hoeller, O., Bolourani, P., Devreotes, P.N.';
