MERGE (p:Paper {number: '178'}) SET p.title = 'Single-molecule analysis of chemoattractant-stimulated membrane recruitment of a PH-domain-containing protein', p.year = 2006, p.journal = 'Journal of Cell Science', p.doi = '10.1242/jcs.02824', p.key_findings = 'The study reveals that individual Crac molecules exhibit dynamic binding to PtdIns(3,4,5)P3, with a rapid exchange rate of approximately 100 milliseconds. This dynamic behavior is crucial for the accurate and sensitive chemotactic movements of Dictyostelium discoideum. Additionally, the research demonstrates that the localization of PH-domain-containing proteins at the leading edge is maintained through rapid recycling, highlighting the importance of these proteins in the chemotactic signaling pathway.', p.paper_type = 'research_article', p.authors = 'Matsuoka, Satomi, Iijima, Miho, Watanabe, Tomonobu M., Kuwayama, Hidekazu, Yanagida, Toshio, Devreotes, Peter N., Ueda, Masahiro';
