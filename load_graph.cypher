MERGE (p:Paper {number: '200'}) SET p.title = 'Ras-mediated activation of the TORC2–PKB pathway is critical for chemotaxis', p.year = 2010, p.journal = 'The Journal of Cell Biology', p.doi = '10.1083/jcb.201001129', p.key_findings = 'The study demonstrates that RasC is an upstream regulator of the TORC2–PKB signaling pathway, which is critical for chemotaxis in Dictyostelium discoideum. Activated RasC prolongs the activation of PKBR1 and enhances the phosphorylation of its substrates, thereby affecting cell migration. The findings suggest that proper temporal and spatial regulation of the PKB pathway is essential for effective chemotactic responses.', p.paper_type = 'research_article', p.authors = 'Cai, Huaqing, Das, Satarupa, Kamimura, Yoichiro, Long, Yu, Parent, Carole A., Devreotes, Peter N.';
