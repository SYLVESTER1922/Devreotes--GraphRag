MERGE (p:Paper {number: '094'}) SET p.title = 'Cloning and Targeted Mutations of Ga7 and Ga8, Two Developmentally Regulated G Protein a-Subunit Genes in Dictyostelium', p.year = 1994, p.journal = 'Molecular Biology of the Cell', p.doi = '', p.key_findings = 'The study identified and characterized two novel G protein a-subunits, Ga7 and Ga8, in Dictyostelium discoideum. Ga7 overexpression led to abnormal morphogenesis, while Ga8 exhibited unique resistance to protease digestion. The findings suggest distinct roles for these a-subunits in the developmental processes of Dictyostelium, highlighting the complexity of G protein signaling in cellular differentiation.', p.paper_type = 'research_article', p.authors = 'Wu, Lijun, Gaskins, Christopher, Zhou, Kemin, Firtel, Richard A., Devreotes, Peter N.';
