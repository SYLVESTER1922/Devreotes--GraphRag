MERGE (p:Paper {number: '104'}) SET p.title = 'Chemoattractant and GTP /S-mediated Stimulation of Adenylyl Cyclase in Dictyostelium Requires Translocation of CRAC to Membranes', p.year = 1995, p.journal = 'The Journal of Cell Biology', p.doi = '', p.key_findings = 'The study demonstrates that CRAC is essential for the activation of adenylyl cyclase in response to chemoattractants in Dictyostelium. It shows that CRAC translocates to the membrane upon stimulation and that it can restore adenylyl cyclase activity in lysates from CRAC-deficient cells. Additionally, the findings suggest that the G-protein β-subunits may play a role in creating binding sites for CRAC, linking it to the activation of adenylyl cyclase. This highlights the importance of CRAC in the signal transduction pathway that regulates cellular aggregation.', p.paper_type = 'research_article', p.authors = 'Lilly, P.J., Devreotes, P.N.';
