MERGE (p:Paper {number: '231'}) SET p.title = 'A large-scale screen reveals genes that mediate electrotaxis in Dictyostelium discoideum', p.year = 2015, p.journal = 'Science Signaling', p.doi = '10.1126/scisignal.aab0562', p.key_findings = 'The study identified 28 mutant strains of Dictyostelium discoideum that were defective in electrotaxis and 10 strains with enhanced responses. Key genes involved in the electrotaxis pathway were identified, including PiaA, GefA, RasC, Rip3, Lst8, and pkbR1, which are components of the TORC2-PKB signaling pathway. The high-throughput screening technique developed in this study provides a powerful tool for elucidating the molecular mechanisms underlying electrotaxis.', p.paper_type = 'research_article', p.authors = 'Gao, R., Zhao, S., Jiang, X., Sun, Y., Zhao, S., Gao, J., Borleis, J., Willard, S., Tang, M., Cai, H., Kamimura, Y., Huang, Y., Jiang, J., Huang, Z., Mogilner, A., Pan, T., Devreotes, P. N., Zhao, M.';
MERGE (pr:Protein {name: 'PiaA'}) WITH pr MATCH (p:Paper {number: '231'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'PiaA encodes a critical component of TORC2, a kinase protein complex that transduces changes in motility by activating the kinase PKB.'}]->(pr);
MERGE (pr:Protein {name: 'PKB'}) WITH pr MATCH (p:Paper {number: '231'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'PKB, also known as Akt, is activated by TORC2 and plays a role in mediating electrotaxis.'}]->(pr);
MERGE (pr:Protein {name: 'GefA'}) WITH pr MATCH (p:Paper {number: '231'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'GefA is a guanine nucleotide exchange factor that is upstream of RasC and TORC2, and is critical for electrotactic responses.'}]->(pr);
MERGE (pr:Protein {name: 'RasC'}) WITH pr MATCH (p:Paper {number: '231'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'RasC is a component of the signaling pathway that regulates electrotaxis and is activated by GefA.'}]->(pr);
MERGE (pr:Protein {name: 'Rip3'}) WITH pr MATCH (p:Paper {number: '231'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'Rip3 is a component of the TORC2 complex that is essential for electrotaxis.'}]->(pr);
MERGE (pr:Protein {name: 'Lst8'}) WITH pr MATCH (p:Paper {number: '231'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'Lst8 is another component of the TORC2 complex that contributes to electrotactic responses.'}]->(pr);
