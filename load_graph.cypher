MERGE (p:Paper {number: '130'}) SET p.title = 'G Protein Signaling Events Are Activated at the Leading Edge of Chemotactic Cells', p.year = 1998, p.journal = 'Cell', p.doi = '', p.key_findings = 'The study demonstrates that G protein signaling events are activated at the leading edge of chemotactic cells, specifically through the translocation of the CRAC protein to the plasma membrane in response to chemoattractants. This localized activation is crucial for the directional movement of cells, highlighting the importance of spatial signaling in chemotaxis. The findings suggest that eukaryotic cells utilize a conserved set of G protein-linked signaling pathways to mediate their chemotactic responses.', p.paper_type = 'research_article', p.authors = 'Parent, C.A., Blacklock, B.J., Froehlich, W.M., Murphy, D.B., Devreotes, P.N.';
