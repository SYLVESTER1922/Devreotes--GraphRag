MERGE (p:Paper {number: '227'}) SET p.title = 'The Directional Response of Chemotactic Cells Depends on a Balance between Cytoskeletal Architecture and the External Gradient', p.year = 2014, p.journal = 'Cell Reports', p.doi = '10.1016/j.celrep.2014.09.047', p.key_findings = 'The study reveals that polarized sensitivity to chemoattractants in neutrophils does not require cell movement or actin dynamics, but is influenced by the static distribution of F-actin. JLY-treated neutrophils maintained a gradient of responsiveness to fMLP, indicating that internal polarity and cytoskeletal architecture are crucial for directional sensing. The findings suggest that the overall directional response of chemotactic cells is a balance between external gradients and internal cytoskeletal organization.', p.paper_type = 'research_article', p.authors = 'Wang, Ming-Jie, Artemenko, Yulia, Cai, Wen-Jie, Iglesias, Pablo A., Devreotes, Peter N.';
