MERGE (p:Paper {number: '132'}) SET p.title = 'Identification of Darlin, a Dictyostelium Protein with Armadillo-like Repeats that Binds to Small GTPases and Is Important for the Proper Aggregation of Developing Cells', p.year = 1998, p.journal = 'Molecular Biology of the Cell', p.doi = '', p.key_findings = 'The study identifies darlin as a novel protein in Dictyostelium that binds to small GTPases such as racE, racC, cdc42Hs, and TC4-ran. Disruption of the darlin gene affects the ability of cells to aggregate in response to starvation, indicating its role in chemotactic signaling. The findings suggest that darlin is involved in a signaling pathway that modulates the chemotactic response during early development, although it is not essential for other cellular processes like cytokinesis.', p.paper_type = 'research_article', p.authors = 'Vithalani, K.K., Parent, C.A., Thorn, E.M., Penn, M., Larochelle, D.A., Devreotes, P.N., De Lozanne, A.';
