MERGE (c:Concept {name: 'chemotaxis'}) WITH c MATCH (p:Paper {number: '231'}) MERGE (p)-[:EXPLORES_CONCEPT {context: 'The study also relates electrotaxis to chemotaxis, as many genes involved in chemotaxis were identified in the screen.'}]->(c);
