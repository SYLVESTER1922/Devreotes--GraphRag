MERGE (p:Paper {number: '186'}) SET p.title = 'Dictyostelium RacH Regulates Endocytic Vesicular Trafficking and is Required for Localization of Vacuolin', p.year = 2006, p.journal = 'Traffic', p.doi = '10.1111/j.1600-0854.2006.00455.x', p.key_findings = 'RacH is essential for proper endocytic vesicular trafficking and localization of vacuolin in Dictyostelium discoideum. RacH-deficient cells showed reduced fluid-phase uptake and altered acidification of early endosomes. The study highlights the importance of RacH\'s subcellular localization for its function, as mistargeted RacH mutants did not replicate the phenotypes of wild-type RacH. Additionally, RacH was found to stimulate actin polymerization, suggesting its role in actin-based trafficking.', p.paper_type = 'research_article', p.authors = 'Baggavalli P. Somesh, Carola Neffgen, Miho Iijima, Peter Devreotes, Francisco Rivero';
