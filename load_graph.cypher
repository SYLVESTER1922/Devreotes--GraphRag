MERGE (c:Concept {name: 'chemotaxis'}) WITH c MATCH (p:Paper {number: '205'}) MERGE (p)-[:EXPLORES_CONCEPT {context: 'The study investigates the role of cAR1 in chemotaxis in Dictyostelium discoideum.'}]->(c);
MERGE (c:Concept {name: 'G-protein coupled receptor signaling'}) WITH c MATCH (p:Paper {number: '205'}) MERGE (p)-[:EXPLORES_CONCEPT {context: 'The paper discusses the dynamics of GPCRs, particularly cAR1, in signaling pathways.'}]->(c);
MERGE (c:Concept {name: 'directed diffusion'}) WITH c MATCH (p:Paper {number: '205'}) MERGE (p)-[:EXPLORES_CONCEPT {context: 'The study demonstrates that cAR1 exhibits directed diffusion rather than random movement.'}]->(c);
MERGE (c:Concept {name: 'microtubule dynamics'}) WITH c MATCH (p:Paper {number: '205'}) MERGE (p)-[:EXPLORES_CONCEPT {context: 'Microtubules were shown to regulate the mobility of cAR1 in the plasma membrane.'}]->(c);
MERGE (o:Organism {name: 'Dictyostelium discoideum'}) WITH o MATCH (p:Paper {number: '205'}) MERGE (p)-[:USES_ORGANISM {context: 'This organism was used to study the dynamics of cAR1 in chemotactic signaling.'}]->(o);
MERGE (o:Organism {name: 'JB4 cells'}) WITH o MATCH (p:Paper {number: '205'}) MERGE (p)-[:USES_ORGANISM {context: 'These cAR1-/cAR3-cells were used to test the functionality of the cAR1-Halo fusion protein.'}]->(o);
MERGE (o:Organism {name: 'AX2 cells'}) WITH o MATCH (p:Paper {number: '205'}) MERGE (p)-[:USES_ORGANISM {context: 'Wild type AX2 cells were transformed for experiments involving cAR1.'}]->(o);
MERGE (p:Paper {number: '085'}) SET p.title = 'CAR2, a prestalk cAMP receptor required for normal tip formation and late development of Dictyostelium discoideum', p.year = 1992, p.journal = 'Genes & Development', p.doi = '', p.key_findings = 'The study identifies CAR2 as a critical cAMP receptor necessary for the late stages of Dictyostelium development, particularly in prestalk cell sorting during aggregation. CAR2 is structurally similar to CAR1 but is expressed at different developmental stages. The findings suggest that multiple cAMP receptors regulate distinct responses during Dictyostelium development, highlighting the complexity of cAMP signaling pathways in this organism.', p.paper_type = 'research_article', p.authors = 'Saxe III, C.L., Ginsburg, G.T., Louis, J.M., Johnson, R., Devreotes, P.N., Kimmel, A.R.';
MERGE (pr:Protein {name: 'CAR1'}) WITH pr MATCH (p:Paper {number: '085'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'CAR1 is a cAMP receptor gene expressed at high levels during the initial stages of Dictyostelium development.'}]->(pr);
MERGE (pr:Protein {name: 'CAR2'}) WITH pr MATCH (p:Paper {number: '085'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'CAR2 is a cAMP receptor subtype that is expressed after aggregation and is required for normal tip formation and late development.'}]->(pr);
MERGE (m:Method {name: 'homologous recombination'}) WITH m MATCH (p:Paper {number: '085'}) MERGE (p)-[:USES_METHOD {context: 'Transgenic Dictyostelium were created by replacing the wild-type CAR2 gene with a defective version through homologous recombination.'}]->(m);
MERGE (m:Method {name: 'PCR'}) WITH m MATCH (p:Paper {number: '085'}) MERGE (p)-[:USES_METHOD {context: 'A polymerase chain reaction (PCR) screen was used to identify transformants that had their endogenous copy of CAR2 replaced.'}]->(m);
MERGE (m:Method {name: 'gel electrophoresis'}) WITH m MATCH (p:Paper {number: '085'}) MERGE (p)-[:USES_METHOD {context: 'Genomic DNA was separated by gel electrophoresis to analyze hybridization patterns with CAR probes.'}]->(m);
MERGE (c:Concept {name: 'cAMP signaling'}) WITH c MATCH (p:Paper {number: '085'}) MERGE (p)-[:EXPLORES_CONCEPT {context: 'Extracellular cAMP serves as a primary signaling molecule regulating the development of Dictyostelium discoideum.'}]->(c);
MERGE (c:Concept {name: 'chemotaxis'}) WITH c MATCH (p:Paper {number: '085'}) MERGE (p)-[:EXPLORES_CONCEPT {context: 'cAMP is required for chemotaxis, aggregation, cytodifferentiation, and morphogenetic movement in Dictyostelium.'}]->(c);
MERGE (o:Organism {name: 'Dictyostelium discoideum'}) WITH o MATCH (p:Paper {number: '085'}) MERGE (p)-[:USES_ORGANISM {context: 'Dictyostelium discoideum was used as a model organism to study the roles of cAMP receptors in development.'}]->(o);
MERGE (p:Paper {number: '089'}) SET p.title = 'Extracellular cAMP is sufficient to restore developmental gene expression and morphogenesis in Dictyostelium cells lacking the aggregation adenylyl cyclase (ACA)', p.year = 1993, p.journal = 'Genes & Development', p.doi = '10.1101/gad.7.11.2172', p.key_findings = 'The study demonstrates that extracellular cAMP is crucial for restoring developmental gene expression and morphogenesis in Dictyostelium cells lacking ACA. Overexpression of ACG can partially rescue these processes, indicating that while intracellular cAMP is not necessary for PKA activation, extracellular cAMP is essential for coordinating cell movement and gene expression during development. The findings underscore the importance of cAMP signaling in the developmental program of Dictyostelium discoideum.', p.paper_type = 'research_article', p.authors = 'Pitt, G.S., Brandt, R., Lin, K.C., Devreotes, P.N., Schaap, P.';
MERGE (pr:Protein {name: 'ACA'}) WITH pr MATCH (p:Paper {number: '089'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'ACA is the aggregation adenylyl cyclase that is essential for producing extracellular cAMP for coordination of cell movement and developmental gene expression.'}]->(pr);
MERGE (pr:Protein {name: 'ACG'}) WITH pr MATCH (p:Paper {number: '089'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'ACG is a constitutively active adenylyl cyclase that partially restores coordination of cell movement and completely restores developmental gene expression in aca- cells.'}]->(pr);
MERGE (pr:Protein {name: 'PKA'}) WITH pr MATCH (p:Paper {number: '089'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'PKA is the cAMP-dependent protein kinase that is activated by intracellular cAMP but does not require ACA for its activation.'}]->(pr);
MERGE (pr:Protein {name: 'cAR1'}) WITH pr MATCH (p:Paper {number: '089'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'cAR1 is a chemotactic cAMP receptor whose expression is restored in aca- cells by stimulation with cAMP pulses.'}]->(pr);
MERGE (pr:Protein {name: 'D19'}) WITH pr MATCH (p:Paper {number: '089'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'D19 is a prespore-specific gene whose expression can be induced to normal levels in aca- cells by micromolar cAMP concentrations.'}]->(pr);
MERGE (pr:Protein {name: 'CSA'}) WITH pr MATCH (p:Paper {number: '089'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'CSA is an aggregative gene whose expression is completely restored in aca- cells by stimulation with cAMP pulses.'}]->(pr);
MERGE (m:Method {name: 'time-lapse cinematography'}) WITH m MATCH (p:Paper {number: '089'}) MERGE (p)-[:USES_METHOD {context: 'This technique was used to visualize the aggregation and development of different Dictyostelium strains.'}]->(m);
MERGE (m:Method {name: 'RNA extraction and Northern blotting'}) WITH m MATCH (p:Paper {number: '089'}) MERGE (p)-[:USES_METHOD {context: 'This method was employed to analyze the expression levels of developmental genes in response to cAMP stimulation.'}]->(m);
MERGE (c:Concept {name: 'cAMP signaling'}) WITH c MATCH (p:Paper {number: '089'}) MERGE (p)-[:EXPLORES_CONCEPT {context: 'cAMP functions as both an extracellular signal and an intracellular second messenger, regulating various stages of Dictyostelium development.'}]->(c);
MERGE (c:Concept {name: 'cell differentiation'}) WITH c MATCH (p:Paper {number: '089'}) MERGE (p)-[:EXPLORES_CONCEPT {context: 'The study explores how cAMP signaling influences the differentiation of Dictyostelium cells into spores and stalk cells.'}]->(c);
MERGE (c:Concept {name: 'morphogenesis'}) WITH c MATCH (p:Paper {number: '089'}) MERGE (p)-[:EXPLORES_CONCEPT {context: 'The research highlights the role of cAMP in coordinating morphogenetic movements during the development of Dictyostelium.'}]->(c);
MERGE (o:Organism {name: 'Dictyostelium discoideum'}) WITH o MATCH (p:Paper {number: '089'}) MERGE (p)-[:USES_ORGANISM {context: 'This organism was used to study the effects of cAMP on development and gene expression.'}]->(o);
MERGE (o:Organism {name: 'aca- cells'}) WITH o MATCH (p:Paper {number: '089'}) MERGE (p)-[:USES_ORGANISM {context: 'These are mutant cells lacking adenylyl cyclase activity, used to investigate the role of cAMP in development.'}]->(o);
MERGE (o:Organism {name: 'Ax-3'}) WITH o MATCH (p:Paper {number: '089'}) MERGE (p)-[:USES_ORGANISM {context: 'Ax-3 is a wild-type strain of Dictyostelium used for comparison with aca- cells in developmental studies.'}]->(o);
