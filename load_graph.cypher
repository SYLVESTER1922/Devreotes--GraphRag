MERGE (p:Paper {number: '144'}) SET p.title = 'The Protein Kinase YakA Regulates G-protein-linked Signaling Responses during Growth and Development of Dictyostelium', p.year = 2001, p.journal = 'The Journal of Biological Chemistry', p.doi = '10.1074/jbc.M103365200', p.key_findings = 'The study identifies YakA as a critical regulator of G-protein-mediated signaling in Dictyostelium, particularly during growth and development. YakA-null mutants exhibit defects in folic acid-induced actin polymerization and cGMP accumulation, indicating its role in these signaling pathways. The research suggests that YakA functions downstream of G-proteins, as cAMP receptors still couple to G-proteins in yakA mutants. Overall, the findings highlight the importance of YakA in the transition from growth to development and its potential evolutionary conservation among Dyrk kinases.', p.paper_type = 'research_article', p.authors = 'van Es, S., Weening, K. E., Devreotes, P. N.';
