MERGE (p:Paper {number: '147'}) SET p.title = 'G in Dictyostelium: Its Role in Localization of G to the Membrane Is Required for Chemotaxis in Shallow Gradients', p.year = 2001, p.journal = 'Molecular Biology of the Cell', p.doi = '', p.key_findings = 'The study identifies the role of G in the localization of G to the membrane, which is essential for chemotaxis in shallow gradients. Overexpression of a CSVL-deleted G (G) shifts G to the cytosol, impairing the ability of cells to sense chemoattractant gradients. This indicates that while G is not essential for responses to increments in stimuli, its membrane localization is critical for directional movement in response to gradients.', p.paper_type = 'research_article', p.authors = 'Zhang, N., Long, Y., Devreotes, P.N.';
