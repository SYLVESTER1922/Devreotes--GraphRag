MERGE (p:Paper {number: '269'}) SET p.title = 'Ras suppression potentiates rear actomyosin contractility-driven cell polarization and migration', p.year = 2024, p.journal = 'Nature Cell Biology', p.doi = '10.1038/s41556-024-01453-4', p.key_findings = 'The study reveals that suppressing Ras activity can lead to unexpected enhancements in cell polarization and migration. Specifically, the recruitment of RasGAPs like C2GAPB and RASAL3 to the cell front results in the rapid cessation of protrusions and a shift in migration direction. This process is critically dependent on myosin II activity, highlighting the intricate balance of Ras signaling in regulating cell motility. These findings have significant implications for drug design targeting oncogenic Ras.', p.paper_type = 'research_article', p.authors = 'Lin, Yiyan, Pal, Dhiman Sankar, Banerjee, Parijat, Banerjee, Tatsat, Qin, Guanghui, Deng, Yu, Borleis, Jane, Iglesias, Pablo A., Devreotes, Peter N.';
