MERGE (p:Paper {number: '105'}) SET p.title = 'The G Protein 13 Subunit Is Essential for Multiple Responses to Chemoattractants in Dictyostelium', p.year = 1995, p.journal = 'The Journal of Cell Biology', p.doi = '', p.key_findings = 'The study reveals that G13 is essential for multiple responses to chemoattractants in Dictyostelium, as g[3- cells fail to aggregate and do not respond to chemoattractants despite normal motility. G13 is required for the activation of adenylyl cyclase and guanylyl cyclase, indicating its role in linking receptors to downstream signaling pathways. Additionally, the growth of g[3- cells is affected by the presence of bacteria, suggesting a defect in phagocytosis.', p.paper_type = 'research_article', p.authors = 'Wu, Lijun, Valkema, Romi, Van Haastert, Peter J. M., Devreotes, Peter N.';
