MERGE (p:Paper {number: '073'}) SET p.title = 'Gene targeting of the aggregation stage cAMP receptor cAR1 in Dictyostelium', p.year = 1991, p.journal = 'Genes & Development', p.doi = '10.1101/gad.5.4.572', p.key_findings = 'The study successfully targeted the cAR1 gene in Dictyostelium, creating null mutants that fail to sense cAMP and arrest in early development. These mutants can be rescued by expressing wild-type cAR1 or a truncated version, demonstrating the importance of cAR1 in developmental signaling. The research highlights the role of cAR1 in mediating cAMP oscillations necessary for proper aggregation and differentiation in Dictyostelium, providing insights into G-protein-linked receptor function in a natural context.', p.paper_type = 'research_article', p.authors = 'Sun, T.J., Devreotes, P.N.';
