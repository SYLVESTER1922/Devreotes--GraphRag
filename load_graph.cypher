MERGE (p:Paper {number: '146'}) SET p.title = 'cAMP receptor affinity controls wave dynamics, geometry and morphogenesis in Dictyostelium', p.year = 2001, p.journal = 'Journal of Cell Science', p.doi = '', p.key_findings = 'The study demonstrates that cAMP receptor affinity significantly influences the dynamics of wave initiation and propagation during the aggregation of Dictyostelium discoideum. It was found that while receptor affinity controls the frequency of wave initiation, it does not affect the velocity of wave propagation. This leads to variations in wave geometry, which are crucial for proper cell aggregation and development. The results underscore the importance of receptor number and affinity in regulating cell-cell signaling dynamics necessary for successful multicellular development.', p.paper_type = 'research_article', p.authors = 'Dormann, D., Kim, J.-Y., Devreotes, P.N., Weijer, C.J.';
