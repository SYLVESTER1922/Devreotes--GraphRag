MERGE (p:Paper {number: '118'}) SET p.title = 'Random Mutagenesis of the cAMP Chemoattractant Receptor, cAR1, of Dictyostelium MUTANT CLASSES THAT CAUSE DISCRETE SHIFTS IN AGONIST AFFINITY AND LOCK THE RECEPTOR IN A NOVEL ACTIVATIONAL INTERMEDIATE', p.year = 1997, p.journal = 'The Journal of Biological Chemistry', p.doi = '', p.key_findings = 'The study identified various classes of cAR1 mutants with distinct effects on cAMP binding and signal transduction. Some mutants displayed conditional defects in cAMP binding, while others lost the ability to transduce signals despite being phosphorylated. This suggests the existence of multiple activated states of cAR1 that interact with different downstream effectors. The findings enhance the understanding of GPCR functionality and the molecular mechanisms underlying receptor activation.', p.paper_type = 'research_article', p.authors = 'Kim, Ji-Yun, Caterina, Michael J., Milne, Jacqueline L. S., Lin, Kenneth C., Borleis, Jane A., Devreotes, Peter N.';
