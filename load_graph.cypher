MERGE (p:Paper {number: '128'}) SET p.title = 'Functional Promiscuity of Gene Regulation by Serpentine Receptors in Dictyostelium discoideum', p.year = 1998, p.journal = 'Molecular and Cellular Biology', p.doi = '', p.key_findings = 'The study demonstrates that all four cAMP receptors (cAR1, cAR2, cAR3, cAR4) in Dictyostelium discoideum can mediate gene induction in response to cAMP pulses, with cAR1 and cAR2 having specific roles in prespore and prestalk gene expression, respectively. Notably, cAR1 is essential for mediating adenosine inhibition of prespore gene expression, while cAR2 is crucial for DIF competence. The findings highlight the functional promiscuity of cARs in regulating developmental gene expression, suggesting that the specificity of gene regulation may arise from the developmental context rather than the receptors themselves.', p.paper_type = 'research_article', p.authors = 'Verkerke-van Wijk, I., Kim, J.Y., Brandt, R., Devreotes, P.N., Schaap, P.';
