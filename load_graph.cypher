MERGE (p:Paper {number: '043'}) SET p.title = 'Purification of the Surface cAMP Receptor in Dictyostelium', p.year = 1987, p.journal = 'The Journal of Biological Chemistry', p.doi = '', p.key_findings = 'The study successfully purified the cAMP receptor from Dictyostelium discoideum, revealing two interconvertible forms, R and D, which differ in electrophoretic mobility and phosphorylation states. The purification process involved hydroxylapatite chromatography and SDS-PAGE, achieving a 6000-fold increase in purity. The findings highlight the receptor\'s role in mediating chemotaxis and cAMP signaling, as well as its reversible modification in response to cAMP stimulation.', p.paper_type = 'research_article', p.authors = 'Klein, P., Knox, B., Borleis, J., Devreotes, P.';
