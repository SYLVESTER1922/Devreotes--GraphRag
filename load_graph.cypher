MERGE (p:Paper {number: '166'}) SET p.title = 'Novel Mechanism of PTEN Regulation by Its Phosphatidylinositol 4,5-Bisphosphate Binding Motif Is Critical for Chemotaxis', p.year = 2004, p.journal = 'The Journal of Biological Chemistry', p.doi = '10.1074/jbc.M312098200', p.key_findings = 'The study reveals that PTEN\'s localization and activity are critical for chemotaxis in Dictyostelium discoideum. The N-terminal PI(4,5)P2 binding motif is essential for PTEN\'s membrane association and function. Mutations in this motif enhance PTEN\'s catalytic activity but prevent its membrane localization, leading to chemotactic defects. These findings provide insights into the regulatory mechanisms of PTEN and its role in cell migration.', p.paper_type = 'research_article', p.authors = 'Iijima, M., Huang, Y.E., Luo, H.R., Vazquez, F., Devreotes, P.N.';
