MERGE (pr:Protein {name: 'cAR1'}) WITH pr MATCH (p:Paper {number: '193'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'cAR1 is a cAMP receptor that is up-regulated during development and critical for oscillatory cAMP production.'}]->(pr);
