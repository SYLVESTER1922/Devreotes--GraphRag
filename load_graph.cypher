MERGE (c:Concept {name: 'receptor modification'}) WITH c MATCH (p:Paper {number: '032'}) MERGE (p)-[:EXPLORES_CONCEPT {context: 'Describes the cAMP-induced changes in the electrophoretic mobility of the receptor.'}]->(c);
MERGE (c:Concept {name: 'adaptation'}) WITH c MATCH (p:Paper {number: '032'}) MERGE (p)-[:EXPLORES_CONCEPT {context: 'Refers to the adjustment of cellular sensitivity during persistent occupancy of the cAMP receptor.'}]->(c);
