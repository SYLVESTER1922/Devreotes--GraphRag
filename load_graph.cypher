MERGE (p:Paper {number: '173'}) SET p.title = 'CHEMOATTRACTANT SIGNALING IN DICTYOSTELIUM DISCOIDEUM', p.year = 2004, p.journal = 'Annual Review of Cell and Developmental Biology', p.doi = '10.1146/annurev.cellbio.20.011303.132633', p.key_findings = 'The review discusses the modular view of chemoattractant signaling pathways in Dictyostelium discoideum, highlighting the roles of various proteins and receptors in mediating chemotaxis. Key components such as cAMP receptors, G proteins, and phosphoinositides are essential for the signaling processes that lead to cell migration and aggregation. The findings emphasize the similarities between Dictyostelium and mammalian systems, suggesting that insights gained from this model organism can inform our understanding of human biology.', p.paper_type = 'review', p.authors = 'Manahan, C.L., Iglesias, P.A., Long, Y., Devreotes, P.N.';
