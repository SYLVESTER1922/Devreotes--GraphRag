MERGE (p:Paper {number: '138'}) SET p.title = 'Di¡erential developmental expression and cell type speci¢city of Dictyostelium catalases and their response to oxidative stress and UV-light', p.year = 2000, p.journal = 'Biochimica et Biophysica Acta', p.doi = '', p.key_findings = 'The study identifies two catalase genes, catA and catB, in Dictyostelium discoideum, which are differentially regulated during development. CatA is consistently expressed, while CatB is specifically localized to prespore cells during morphogenesis. The research demonstrates that exposure to hydrogen peroxide does not induce the expression of these antioxidant enzymes, indicating that the organism\'s resistance to oxidative stress is not due to rapid upregulation of these genes. This suggests a distinct response mechanism to oxidative stress compared to UV-light exposure.', p.paper_type = 'research_article', p.authors = 'Garcia, M.X.U., Foote, C., van Es, S., Devreotes, P.N., Alexander, S., Alexander, H.';
