MERGE (p:Paper {number: '276'}) SET p.title = 'Ras-mediated dynamic and biphasic regulation of cell migration', p.year = 2025, p.journal = 'Proceedings of the National Academy of Sciences of the United States of America', p.doi = '10.1073/pnas.2503847122', p.key_findings = 'The study challenges the traditional view of Ras as solely a positive regulator of cell functions, revealing a biphasic relationship where both excessive and insufficient Ras activity impair cell migration. It highlights the importance of optimal Ras activity and cortical tension for efficient migration. The findings suggest that targeting Ras in cancer therapy requires consideration of the cell\'s initial state, as simply inhibiting Ras could inadvertently promote metastasis. This nuanced understanding emphasizes the need for sophisticated approaches in targeting Ras for effective cancer treatment.', p.paper_type = 'research_article', p.authors = 'L, Yiyan, Parajón, Eleana, Yuan, Qinling, Ye, Siyu, Qin, Guanghui, Deng, Yu, Borleis, Jane, Koyfman, Ariel, Iglesias, Pablo A., Konstantopoulos, Konstantinos, Robinson, Douglas N., Devreotes, Peter N.';
MERGE (pr:Protein {name: 'Ras'}) WITH pr MATCH (p:Paper {number: '276'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'Ras is shown to have a biphasic relationship with cell migration, where both excessive and insufficient activity impair migration.'}]->(pr);
MERGE (pr:Protein {name: 'GefA'}) WITH pr MATCH (p:Paper {number: '276'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'GefA is a guanine nucleotide exchange factor that, when recruited, alters cell morphology and migration dynamics.'}]->(pr);
