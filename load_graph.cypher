MERGE (p:Paper {number: '096'}) SET p.title = 'CRAC, a Cytosolic Protein Containing a Pleckstrin Homology Domain, Is Required for Receptor and G Protein-mediated Activation of Adenylyl Cyclase in Dictyostelium', p.year = 1994, p.journal = 'The Journal of Cell Biology', p.doi = '', p.key_findings = 'The study identifies CRAC as a crucial cytosolic protein that connects G protein βγ subunits to the activation of adenylyl cyclase in Dictyostelium. Mutants lacking CRAC (dagA-) are unable to activate adenylyl cyclase despite normal responses to cAMP, indicating that CRAC is essential for this signaling pathway. The research also shows that the expression of dagA can restore normal development in transformed mutant cells, highlighting its role in the developmental processes of Dictyostelium.', p.paper_type = 'research_article', p.authors = 'Insall, R., Kuspa, A., Lilly, P.J., Shaulsky, G., Levin, L.R., Loomis, W.F., Devreotes, P.';
