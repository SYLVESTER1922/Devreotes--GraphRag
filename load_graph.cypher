MERGE (p:Paper {number: '169'}) SET p.title = 'Chemoattractant-induced phosphatidylinositol 3,4,5-trisphosphate accumulation is spatially amplified and adapts, independent of the actin cytoskeleton', p.year = 2004, p.journal = 'Proceedings of the National Academy of Sciences of the United States of America', p.doi = '10.1073/pnas.0402152101', p.key_findings = 'The study reveals that PI(3,4,5)P3 accumulation is spatially amplified in response to chemoattractant gradients, independent of the actin cytoskeleton. It demonstrates that the localization of PI(3,4,5)P3 is enhanced in polarized cells and that cells can respond to multiple gradients simultaneously. The results support a local excitation-global inhibition model, providing insights into the mechanisms of gradient sensing and polarization in chemotaxis.', p.paper_type = 'research_article', p.authors = 'Janetopoulos, C., Ma, L., Devreotes, P.N., Iglesias, P.A.';
