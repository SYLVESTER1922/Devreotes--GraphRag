MERGE (p:Paper {number: '160'}) SET p.title = 'Eukaryotic Chemotaxis: Distinctions between Directional Sensing and Polarization', p.year = 2003, p.journal = 'The Journal of Biological Chemistry', p.doi = '10.1074/jbc.R300010200', p.key_findings = 'The review discusses the mechanisms of directional sensing and polarization in cells, emphasizing the role of G protein-coupled receptors and the importance of PIP3 in chemotactic signaling. It highlights the similarities between D. discoideum and mammalian leukocytes in their chemotactic responses. The authors propose a local excitation-global inhibition model to explain how cells localize their responses to directional cues, while also acknowledging the need for elements from other models to fully account for polarization.', p.paper_type = 'review', p.authors = 'Devreotes, P., Janetopoulos, C.';
