MERGE (p:Paper {number: '261'}) SET p.title = 'Coupling traction force patterns and actomyosin wave dynamics reveals mechanics of cell motion', p.year = 2021, p.journal = 'Molecular Systems Biology', p.doi = '10.15252/msb.202110505', p.key_findings = 'The study reveals that the wave dynamics of cytoskeletal components critically determine traction force patterns and cell morphology in Dictyostelium discoideum. It identifies two distinct propulsion mechanisms in fan-shaped cells, each associated with different traction force patterns. The findings suggest that cell motion is generated by friction between the cytoskeletal network and the substrate, highlighting the importance of actin and myosin dynamics in cell migration. The results contribute to a better understanding of the mechanics underlying various migration modes in motile cells.', p.paper_type = 'research_article', p.authors = 'Ghabache, E., Cao, Y., Miao, Y., Groisman, A., Devreotes, P.N., Rappel, W.-J.';
