MERGE (p:Paper {number: '257'}) SET p.title = 'Electric signals counterbalanced posterior vs anterior PTEN signaling in directed migration of Dictyostelium', p.year = 2021, p.journal = 'Cell & Bioscience', p.doi = '10.1186/s13578-021-00580-x', p.key_findings = 'The study demonstrates that electric signals promote PTEN phosphatase activity and its asymmetrical translocation to the posterior plasma membrane of electrotaxing Dictyostelium cells. This asymmetric redistribution of PTEN is an early event that precedes the posterior translocation of myosin II and the anterior relocalization of PIP3/F-actin. The findings suggest that PTEN plays a crucial role in coordinating the directed migration of cells in response to electric fields.', p.paper_type = 'research_article', p.authors = 'Song, B., Gu, Y., Jiang, W., Li, Y., Ayre, W.N., Liu, Z., Yin, T., Janetopoulos, C., Iijima, M., Devreotes, P., Zhao, M.';
