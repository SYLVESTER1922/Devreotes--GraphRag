MERGE (p:Paper {number: '232'}) SET p.title = 'The GATA transcription factor GtaC regulates early developmental gene expression dynamics in Dictyostelium', p.year = 2015, p.journal = 'Nature Communications', p.doi = '10.1038/ncomms8551', p.key_findings = 'GtaC is essential for early development in Dictyostelium, regulating gene expression dynamics in response to cAMP pulses. The study identifies GtaC target genes involved in cAMP signaling and cell-type specification. GtaC exhibits dynamic DNA-binding patterns throughout development, with distinct binding at early and late aggregation stages. The findings suggest that GtaC plays a critical role in orchestrating the transition from unicellular to multicellular forms in Dictyostelium.', p.paper_type = 'research_article', p.authors = 'Santhanam, B., Cai, H., Devreotes, P.N., Shaulsky, G., Katoh-Kurasawa, M.';
