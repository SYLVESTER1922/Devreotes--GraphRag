MERGE (p:Paper {number: '208'}) SET p.title = 'Generation of cells that ignore the effects of PIP3 on cytoskeleton', p.year = 2011, p.journal = 'Cell Cycle', p.doi = '10.4161/cc.10.17.16744', p.key_findings = 'The study reveals that gene disruptions can suppress defects caused by delocalized PtdIns(3,4,5)P3 in Dictyostelium cells lacking PTEN. Disruption of PkbA restores cytokinesis and improves chemotaxis in these cells. Additionally, the phosphorylation of PakA is shown to be crucial for mediating the effects of PtdIns(3,4,5)P3, highlighting the importance of PKB signaling in cell migration. This research suggests that targeting PKB signaling could inadvertently enhance the polarity and migration of PTEN-negative cells.', p.paper_type = 'research_article', p.authors = 'Tang, Ming, Iijima, Miho, Devreotes, Peter';
