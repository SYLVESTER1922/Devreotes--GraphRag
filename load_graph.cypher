MERGE (p:Paper {number: '122'}) SET p.title = 'Dynamic Distribution of Chemoattractant Receptors in Living Cells During Chemotaxis and Persistent Stimulation', p.year = 1997, p.journal = 'The Journal of Cell Biology', p.doi = '', p.key_findings = 'The study found that cAR1-GFP remains uniformly distributed on the surface of Dictyostelium discoideum cells during chemotaxis and desensitization, challenging the notion that receptor polarization is due to asymmetric distribution. The cAR1-GFP fusion protein was functionally indistinguishable from wild-type cAR1, allowing for nonintrusive visualization of receptor dynamics. Additionally, the research demonstrated that receptor capping occurs in response to Con A treatment, indicating receptor mobility within the membrane.', p.paper_type = 'research_article', p.authors = 'Xiao, Zhan, Zhang, Ning, Murphy, Douglas B., Devreotes, Peter N.';
