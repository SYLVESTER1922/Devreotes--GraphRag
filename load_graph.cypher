MERGE (p:Paper {number: '056'}) SET p.title = 'Ligand-induced Modification of a Surface cAMP Receptor of Dictyostelium discoideum Does Not Require Its Occupancy', p.year = 1988, p.journal = 'The Journal of Biological Chemistry', p.doi = '', p.key_findings = 'The study demonstrates that cAMP induces both down-regulation and modification of the cAMP receptor in Dictyostelium discoideum. Notably, the modification occurs regardless of whether the receptor is occupied by cAMP, indicating that both occupied and unoccupied receptors can be modified. The findings suggest a complex regulatory mechanism involving receptor phosphorylation and adaptation to cAMP signaling.', p.paper_type = 'research_article', p.authors = 'Snaar-Jagalska, B. Ewa, Devreotes, Peter N., Van Haastert, Peter J. M.';
