MERGE (p:Paper {number: '271'}) SET p.title = 'Self-organizing glycolytic waves fuel cell migration and cancer progression', p.year = 2024, p.journal = 'bioRxiv', p.doi = '10.1101/2024.01.28.577603', p.key_findings = 'The study reveals that glycolytic enzymes are localized in cortical waves in human epithelial cells, which are associated with enhanced ATP production and cell migration. The recruitment of these enzymes to the cell cortex is regulated by Ras/PI3K signaling and correlates with the metastatic potential of cancer cells. Additionally, perturbations that alter wave dynamics significantly impact glycolytic activity, suggesting a coordinated mechanism between glycolysis and cellular protrusions in cancer progression.', p.paper_type = 'research_article', p.authors = 'Zhan, H., Pal, D.S., Borleis, J., Janetopoulos, C., Huang, C.-H., Devreotes, P.N.';
