MERGE (p:Paper {number: '142'}) SET p.title = 'The Phosphorylated C-Terminus of cAR1 Plays a Role in Cell-Type-Speciﬁc Gene Expression and STATa Tyrosine Phosphorylation', p.year = 2001, p.journal = 'Developmental Biology', p.doi = '10.1006/dbio.2001.0217', p.key_findings = 'The study reveals that the phosphorylated C-terminus of cAR1 plays a significant role in regulating cell-type-specific gene expression and morphogenesis in Dictyostelium. While cAR1 phosphorylation is not essential for GBF-mediated postaggregative gene expression, it is crucial for the proper activation of STATa and the overall multicellular development. Mutant receptors with altered phosphorylation patterns exhibit distinct developmental defects, highlighting the importance of cAR1\'s C-terminal phosphorylation in signaling pathways.', p.paper_type = 'research_article', p.authors = 'Briscoe, C., Moniakis, J., Kim, J.Y., Brown, J.M., Hereld, D., Devreotes, P.N., Firtel, R.A.';
