MERGE (p:Paper {number: '019'}) SET p.title = 'Cyclic 3\',5\'-AMP Relay in Dictyostelium discoideum V. Adaptation of the CAMP Signaling Response during cAMP Stimulation', p.year = 1980, p.journal = 'The Journal of Cell Biology', p.doi = '', p.key_findings = 'The study demonstrates that adaptation to cAMP stimuli in Dictyostelium discoideum occurs rapidly and is dependent on the duration and concentration of the initial stimulus. Responses to subsequent lower concentrations of cAMP are progressively attenuated as a result of this adaptation. The findings support a model where the occupancy of cAMP receptors leads to opposing processes of excitation and adaptation, which together regulate adenylate cyclase activity.', p.paper_type = 'research_article', p.authors = 'Dinauer, M.C., Steck, T.L., Devreotes, P.N.';
