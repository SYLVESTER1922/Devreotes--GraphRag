MERGE (p:Paper {number: '245'}) SET p.title = 'Mutually inhibitory Ras-PI(3,4)P2 feedback loops mediate cell migration', p.year = 2018, p.journal = 'Proceedings of the National Academy of Sciences', p.doi = '10.1073/pnas.1809039115', p.key_findings = 'The study reveals that Ras and PI(3,4)P2 engage in mutually inhibitory feedback loops that are essential for cell migration. Disruption of PI(3,4)P2 levels through the action of Dd5P4 or INPP4B leads to increased Ras activity and altered migratory behavior. The findings suggest that these feedback mechanisms are crucial for maintaining the excitability of signal transduction networks in cells, with implications for understanding physiological processes such as immune response and cancer metastasis.', p.paper_type = 'research_article', p.authors = 'Li, X., Edwards, M., Swaney, K.F., Singh, N., Bhattacharya, S., Borleis, J., Long, Y., Iglesias, P.A., Chen, J., Devreotes, P.N.';
