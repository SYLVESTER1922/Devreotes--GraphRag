MERGE (p:Paper {number: '235'}) SET p.title = 'Gβ Regulates Coupling between Actin Oscillators for Cell Polarity and Directional Migration', p.year = 2016, p.journal = 'PLOS Biology', p.doi = '10.1371/journal.pbio.1002381', p.key_findings = 'The study demonstrates that Gβ regulates the coupling strength between actin oscillators, which is crucial for cell polarization and directional migration. Acute inactivation of Gβ leads to strong synchronization of actin oscillators, impairing the cell\'s ability to sense internal and external cues. A mathematical model supports the idea that optimal coupling strength enhances sensitivity to noisy inputs, suggesting that Gβ plays a key role in tuning actin dynamics for effective chemotaxis.', p.paper_type = 'research_article', p.authors = 'Hoeller, O., Toettcher, J.E., Cai, H., Sun, Y., Huang, C-H., Freyre, M., Zhao, M., Devreotes, P.N., Weiner, O.D.';
