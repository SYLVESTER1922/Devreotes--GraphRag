MERGE (p:Paper {number: '151'}) SET p.title = 'Genetic analysis of the role of G protein–coupled receptor signaling in electrotaxis', p.year = 2002, p.journal = 'The Journal of Cell Biology', p.doi = '10.1083/jcb.200112070', p.key_findings = 'The study demonstrates that Dictyostelium discoideum exhibits robust electrotaxis in response to direct current electric fields, independent of G protein–coupled receptor signaling. While Gα-null mutations suppressed electrotaxis, cAR1−/cAR3− and Gγ2− cells maintained significant directional migration. The findings suggest that the pathways for electrotaxis and chemotaxis intersect downstream of heterotrimeric G proteins, highlighting the distinct mechanisms of signal reception and transduction in these processes.', p.paper_type = 'research_article', p.authors = 'Zhao, M., Jin, T., McCaig, C.D., Forrester, J.V., Devreotes, P.N.';
