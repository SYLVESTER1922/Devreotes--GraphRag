MERGE (p:Paper {number: '121'}) SET p.title = 'Phosphorylation of Chemoattractant Receptors Is Not Essential for Chemotaxis or Termination of G-protein-mediated Responses', p.year = 1997, p.journal = 'The Journal of Biological Chemistry', p.doi = '', p.key_findings = 'The study reveals that phosphorylation of the chemoattractant receptor cAR1 is not essential for the termination of G-protein-mediated responses such as adenylyl cyclase activation, actin polymerization, and chemotaxis. Despite the lack of phosphorylation, cAR1 mutants were still capable of mediating these responses, suggesting the existence of alternative phosphorylation-independent adaptation mechanisms. This finding challenges the traditional view of receptor desensitization and adaptation in G-protein-coupled signaling pathways.', p.paper_type = 'research_article', p.authors = 'Kim, Ji-Yun, Soede, Ron D. M., Schaap, Pauline, Valkema, Romi, Borleis, Jane A., Van Haastert, Peter J. M., Devreotes, Peter N., Hereld, Dale';
