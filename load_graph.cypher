MERGE (p:Paper {number: '179'}) SET p.title = 'Tumor suppressor PTEN acts through dynamic interaction with the plasma membrane', p.year = 2006, p.journal = 'Proceedings of the National Academy of Sciences of the United States of America', p.doi = '10.1073/pnas.0510570103', p.key_findings = 'The study demonstrates that PTEN dynamically associates with the plasma membrane, with a dwell time of approximately 400 ms, allowing it to dephosphorylate PIP3. The findings suggest that this transient binding is crucial for PTEN\'s lipid phosphatase activity in vivo. Additionally, the research indicates that the low levels of PTEN bound to the membrane are necessary for its function, highlighting the importance of membrane dynamics in tumor suppression.', p.paper_type = 'research_article', p.authors = 'Vazquez, F., Matsuoka, S., Sellers, W. R., Yanagida, T., Ueda, M., Devreotes, P. N.';
