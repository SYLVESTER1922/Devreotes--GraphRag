MERGE (p:Paper {number: '141'}) SET p.title = 'Receptor-Mediated Activation of Heterotrimeric G-Proteins in Living Cells', p.year = 2001, p.journal = 'Science', p.doi = '', p.key_findings = 'The study demonstrates that G-protein activation in Dictyostelium discoideum can be visualized in real-time using FRET between tagged Ga2 and Gb subunits. It was found that G-protein activation reaches a steady-state level even when physiological responses subside, indicating that adaptation occurs downstream of the G-protein cycle. The research suggests that receptors may act catalytically, as the steady-state level of G-protein activation saturates before all receptors are fully occupied. This work provides insights into the dynamics of G-protein signaling and its implications for understanding cellular responses to chemoattractants.', p.paper_type = 'research_article', p.authors = 'Janetopoulos, C., Jin, T., Devreotes, P.';
