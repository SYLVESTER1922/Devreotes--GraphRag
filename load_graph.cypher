MERGE (p:Paper {number: '163'}) SET p.title = 'Two Phases of Actin Polymerization Display Different Dependencies on PI(3,4,5)P3 Accumulation and Have Unique Roles during Chemotaxis', p.year = 2003, p.journal = 'Molecular Biology of the Cell', p.doi = '10.1091/mbc.E03–05–0339', p.key_findings = 'The study reveals that actin polymerization during chemotaxis occurs in two distinct phases, each with different dependencies on PI(3,4,5)P3 accumulation. The initial rapid phase is associated with cell rounding and is less sensitive to PI3K inhibition, while the slower phase is crucial for pseudopod extension and is more affected by PI3K activity. Disruption of PTEN enhances the second phase of actin polymerization, indicating its role in regulating PI levels and chemotactic responses.', p.paper_type = 'research_article', p.authors = 'Chen, L.F., Janetopoulos, C., Huang, Y.E., Iijima, M., Borleis, J., Devreotes, P.N.';
