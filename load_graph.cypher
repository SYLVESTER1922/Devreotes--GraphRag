MERGE (pr:Protein {name: 'Ga2'}) WITH pr MATCH (p:Paper {number: '247'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'A subunit of the cognate G protein that mediates chemotactic signaling.'}]->(pr);
MERGE (pr:Protein {name: 'Gbg'}) WITH pr MATCH (p:Paper {number: '247'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'The beta-gamma subunit of the cognate G protein involved in chemotaxis.'}]->(pr);
MERGE (pr:Protein {name: 'Gip1'}) WITH pr MATCH (p:Paper {number: '247'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'A G protein-binding protein that sequesters Ga2Gbg proteins and regulates their recruitment to the plasma membrane.'}]->(pr);
