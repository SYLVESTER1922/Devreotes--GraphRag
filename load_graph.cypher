MERGE (p:Paper {number: '254'}) SET p.title = 'An Excitable Ras/PI3K/ERK Signaling Network Controls Migration and Oncogenic Transformation in Epithelial Cells', p.year = 2020, p.journal = 'Developmental Cell', p.doi = '10.1016/j.devcel.2020.08.001', p.key_findings = 'The study reveals that the Ras/PI3K/ERK signaling network in epithelial cells exhibits properties of an excitable system, with activities propagating as waves influenced by growth factors. Oncogenic transformation increases wave activity and alters the threshold of excitability, suggesting that cancer progression can be viewed as a shift to a lower threshold state. The findings highlight the importance of this signaling network in driving cellular protrusions and migration, providing insights into cancer severity and potential interventions.', p.paper_type = 'research_article', p.authors = 'Zhan, H., Bhattacharya, S., Cai, H., Iglesias, P.A., Huang, C.-H., Devreotes, P.N.';
