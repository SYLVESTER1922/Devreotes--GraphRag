MERGE (p:Paper {number: '188'}) SET p.title = 'Leading-edge research: PtdIns(3,4,5)P3 and directed migration', p.year = 2007, p.journal = 'Nature Cell Biology', p.doi = '', p.key_findings = 'The studies reveal that PtdIns(3,4,5)P3 accumulates at the leading edge of neutrophils during chemotaxis, with SHIP1 playing a crucial role in its degradation and localization. Interestingly, neutrophils lacking PTEN can still migrate effectively, suggesting that SHIP1 is a more significant regulator of PtdIns(3,4,5)P3 levels. The findings also indicate that PI(3)Kγ influences neutrophil speed and adhesion, highlighting the complex regulation of chemotaxis by phosphoinositides.', p.paper_type = 'news_and_views', p.authors = 'Franca-Koh, J., Kamimura, Y., Devreotes, P.N.';
