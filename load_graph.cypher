MERGE (p:Paper {number: '031'}) SET p.title = 'Identification and Cyclic AMP-induced Modification of the Cyclic AMP Receptor in Dictyostelium discoideum', p.year = 1985, p.journal = 'The Journal of Biological Chemistry', p.doi = '', p.key_findings = 'The study identifies a cAMP receptor in Dictyostelium discoideum that undergoes cyclic AMP-induced modification, affecting its ability to mediate chemotaxis. The receptor appears as a doublet in SDS-PAGE, with the lower band form activating chemotaxis and the upper band form not. This reversible modification may serve as a mechanism for adaptation to persistent cAMP signaling, influencing gene expression based on the receptor\'s state.', p.paper_type = 'research_article', p.authors = 'Klein, P., Theibert, A., Fontana, D., Devreotes, P.N.';
