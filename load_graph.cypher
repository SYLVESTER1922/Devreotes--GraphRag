MERGE (p:Paper {number: '243'}) SET p.title = 'Insight from the maximal activation of the signal transduction excitable network in Dictyostelium discoideum', p.year = 2018, p.journal = 'Proceedings of the National Academy of Sciences', p.doi = '10.1073/pnas.1710480115', p.key_findings = 'The study reveals that expressing activated Ras GTPase-family proteins in Dictyostelium discoideum cells lacking PTEN leads to persistent activation of the signal transduction network, resulting in dramatic morphological changes and increased adhesion. This persistent activation is associated with severe consequences for cell viability, including catastrophic fragmentation. The findings provide insights into the feedback mechanisms controlling the excitability of the signal transduction network, which is critical for understanding cell migration.', p.paper_type = 'research_article', p.authors = 'Edwards, M., Cai, H., Abubaker-Sharif, B., Long, Y., Lampert, T.J., Devreotes, P.N.';
