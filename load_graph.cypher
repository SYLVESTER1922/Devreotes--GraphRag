MERGE (p:Paper {number: '184'}) SET p.title = 'Phosphoinositide signaling plays a key role in cytokinesis', p.year = 2006, p.journal = 'The Journal of Cell Biology', p.doi = '10.1083/jcb.200603156', p.key_findings = 'The study highlights the critical role of phosphoinositides, particularly PI(4,5)P2 and PI(3,4,5)P3, in regulating cell migration and cytokinesis. It demonstrates that these lipids are essential for maintaining cell polarity and facilitating the morphological changes required during these processes. The research also reveals that perturbations in phosphoinositide signaling can lead to defects in cytokinesis, emphasizing the importance of lipid signaling in cell division. Overall, the findings suggest a complex interplay between membrane phosphoinositides and the cytoskeletal dynamics that govern cell shape changes during migration and division.', p.paper_type = 'review', p.authors = 'Janetopoulos, C., Devreotes, P.';
