MERGE (p:Paper {number: '091'}) SET p.title = 'G Protein-Linked Signaling Pathways Control the Developmental Program of Dictyostelium', p.year = 1993, p.journal = 'Annual Review of Cell and Developmental Biology', p.doi = '', p.key_findings = 'The study highlights the essential role of G protein-linked signaling pathways in the developmental program of Dictyostelium discoideum. It identifies specific receptors and G proteins that mediate responses to cAMP, which is crucial for cell aggregation and differentiation. The research also reveals that certain signaling components, such as CRAC, are necessary for the activation of adenylyl cyclase, indicating complex interactions within the signaling network. Overall, these findings underscore the evolutionary conservation of signaling mechanisms across species.', p.paper_type = 'review', p.authors = 'Devreotes, P.N.';
