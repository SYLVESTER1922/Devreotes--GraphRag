MERGE (p:Paper {number: '213'}) SET p.title = 'Tumor suppressor Hippo/MST1 kinase mediates chemotaxis by regulating spreading and adhesion', p.year = 2012, p.journal = 'Proceedings of the National Academy of Sciences', p.doi = '10.1073/pnas.1211304109', p.key_findings = 'The study identifies KrsB as a critical negative regulator of cell spreading and adhesion in Dictyostelium discoideum, which is essential for proper chemotaxis. KrsB\'s function is regulated by phosphorylation, particularly at threonine 176, and its absence leads to excessive adhesion and impaired directional movement. The findings suggest that the Hippo/MST signaling pathway plays a significant role in regulating cell morphology and migration, highlighting its importance beyond cell growth regulation.', p.paper_type = 'research_article', p.authors = 'Artemenko, Y., Batsios, P., Borleis, J., Gagnon, Z., Lee, J., Rohlfs, M., Sanséau, D., Willard, S.S., Schleicher, M., Devreotes, P.N.';
