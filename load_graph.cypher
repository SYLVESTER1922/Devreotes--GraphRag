MERGE (p:Paper {number: '216'}) SET p.title = 'Hippo and its mammalian homologs', p.year = 2013, p.journal = 'Cell Cycle', p.doi = '10.4161/cc.23668', p.key_findings = 'MST1 and MST2 are important tumor suppressors that regulate cell proliferation and survival, but also play roles in cell morphology, adhesion, and migration. KrsB, a homolog of MST1/2 in Dictyostelium, negatively regulates cell adhesion and is crucial for chemotaxis and directed migration. Unlike its mammalian counterparts, KrsB does not affect cell growth, making Dictyostelium a unique model for studying the Hippo pathway\'s growth-independent functions.', p.paper_type = 'research_article', p.authors = 'Artemenko, Y., Devreotes, P.N.';
