MERGE (p:Paper {number: '258'}) SET p.title = 'Hedgehog signaling and Tre1 regulate actin dynamics through PI(4,5)P2 to direct migration of Drosophila embryonic germ cells', p.year = 2021, p.journal = 'Cell Reports', p.doi = '10.1016/j.celrep.2021.108799', p.key_findings = 'The study identifies Tre1 as a critical G-protein coupled receptor necessary for the navigation of Drosophila embryonic germ cells. It demonstrates that Tre1 localizes with F-actin and regulates actin dynamics through PI(4,5)P2 and dPIP5K. Additionally, Hedgehog signaling through Smoothened enhances Tre1 localization at the plasma membrane, suggesting a mechanism for how these signals guide germ cell migration. The findings provide insights into the molecular events that underlie cell navigation during development.', p.paper_type = 'research_article', p.authors = 'Kim, Ji Hoon, Hanlon, Caitlin D., Vohra, Sunaina, Devreotes, Peter N., Andrew, Deborah J.';
MERGE (pr:Protein {name: 'Tre1'}) WITH pr MATCH (p:Paper {number: '258'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'Tre1 is a G-protein coupled receptor required for Drosophila germ cell navigation.'}]->(pr);
MERGE (pr:Protein {name: 'F-actin'}) WITH pr MATCH (p:Paper {number: '258'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'F-actin localizes at the migration front and is essential for germ cell movement.'}]->(pr);
