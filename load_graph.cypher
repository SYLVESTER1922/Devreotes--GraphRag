MERGE (p:Paper {number: '086'}) SET p.title = 'Identification and targeted gene disruption of cAR3, a cAMP receptor subtype expressed during multicellular stages of Dictyostelium development', p.year = 1993, p.journal = 'Genes & Development', p.doi = '10.1101/gad.7.2.273', p.key_findings = 'The study identifies cAR3 as a new cAMP receptor subtype in Dictyostelium, which is expressed during late aggregation stages. Unlike cAR1 and cAR2, disruption of cAR3 does not result in an overt developmental phenotype, suggesting that cAR1 and cAR2 can compensate for its loss. The findings highlight the complexity of cAMP signaling in coordinating cellular responses during development.', p.paper_type = 'research_article', p.authors = 'Johnson, R.L., Saxe III, C.L., Gollop, R., Kimmel, A.R., Devreotes, P.N.';
