MERGE (p:Paper {number: '092'}) SET p.title = 'Mutation of the Third Intracellular Loop of the CAMP Receptor, cAR1, of Dictyostelium Yields Mutants Impaired in Multiple Signaling Pathways', p.year = 1994, p.journal = 'The Journal of Biological Chemistry', p.doi = '', p.key_findings = 'The study identified a class of cAR1 mutants that bind cAMP with high affinity but are severely impaired in both G-protein-dependent and G-protein-independent functions. These mutants exhibited normal aggregation and fruiting body formation, suggesting that they do not have dominant negative effects. The findings indicate that the third intracellular loop of cAR1 is critical for its activation and signaling capabilities, highlighting the importance of receptor conformation in mediating cellular responses.', p.paper_type = 'research_article', p.authors = 'Caterina, M.J., Milne, J.L.S., Devreotes, P.N.';
