MERGE (pr:Protein {name: 'differentiation-inducing factor (DIF)'}) WITH pr MATCH (p:Paper {number: '128'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'DIF induces prestalk gene expression after cells have been prestimulated with cAMP.'}]->(pr);
MERGE (pr:Protein {name: 'glycogen synthase kinase 3 (GSK-3)'}) WITH pr MATCH (p:Paper {number: '128'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'GSK-3 is the target for the effects of wingless and wnt in insects and vertebrates.'}]->(pr);
MERGE (pr:Protein {name: 'RasD'}) WITH pr MATCH (p:Paper {number: '128'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'RasD is a postaggregative gene induced by cAMP.'}]->(pr);
