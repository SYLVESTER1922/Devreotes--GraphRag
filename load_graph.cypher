MERGE (p:Paper {number: '037'}) SET p.title = 'A Mechanism for Exact Sensory Adaptation Based on Receptor Modification', p.year = 1986, p.journal = 'Journal of Theoretical Biology', p.doi = '', p.key_findings = 'The paper presents a theoretical model for sensory adaptation that involves receptor modification, allowing for exact adaptation to step increases in stimuli. It demonstrates that the activity of a sensory system can be maintained at a constant level despite changes in stimulus concentration through a linear combination of receptor states. The model is applicable to both cAMP secretion in Dictyostelium discoideum and chemotaxis in bacteria, providing insights into the molecular mechanisms underlying sensory adaptation.', p.paper_type = 'research_article', p.authors = 'SEGEL, L.A., GOLDBETER, A., DEVREOTES, P.N., KNOX, B.E.';
MERGE (pr:Protein {name: 'cAMP'}) WITH pr MATCH (p:Paper {number: '037'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'cAMP synthesis is central to the intercellular signaling system in Dictyostelium discoideum.'}]->(pr);
