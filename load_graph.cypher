MERGE (p:Paper {number: '131'}) SET p.title = 'Desensitization of G-protein-coupled Receptors AGONIST-INDUCED PHOSPHORYLATION OF THE CHEMOATTRACTANT RECEPTOR cAR1 LOWERS ITS INTRINSIC AFFINITY FOR cAMP*', p.year = 1999, p.journal = 'The Journal of Biological Chemistry', p.doi = '', p.key_findings = 'The study successfully purified the chemoattractant receptor cAR1, demonstrating that agonist-induced phosphorylation lowers its intrinsic affinity for cAMP. This decrease in affinity is proposed to be a mechanism for maintaining receptor sensitivity at high agonist levels. Additionally, the research highlights the role of phosphorylation in receptor desensitization and the potential for cAR1 to couple with arrestins, impacting downstream signaling processes.', p.paper_type = 'research_article', p.authors = 'Xiao, Zhan, Yao, Yihong, Long, Yu, Devreotes, Peter';
