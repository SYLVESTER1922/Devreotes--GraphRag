MERGE (p:Paper {number: '129'}) SET p.title = 'Selection of Gb Subunits with Point Mutations That Fail to Activate Specific Signaling Pathways In Vivo: Dissecting Cellular Responses Mediated by a Heterotrimeric G Protein in Dictyostelium discoideum', p.year = 1998, p.journal = 'Molecular Biology of the Cell', p.doi = '', p.key_findings = 'The study identified Gb subunits with point mutations that selectively fail to activate certain signaling pathways while retaining the ability to mediate others. These mutant Gbg subunits were able to couple to the cAR1 receptor and support gene expression and actin polymerization, but were defective in activating adenylyl cyclase. This work provides insights into the specificity of Gbg signaling and its role in regulating cellular responses during development in Dictyostelium discoideum.', p.paper_type = 'research_article', p.authors = 'Jin, T., Amzel, M., Devreotes, P.N., Wu, L.';
