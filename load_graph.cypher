MERGE (m:Method {name: 'site-directed mutagenesis'}) WITH m MATCH (p:Paper {number: '121'}) MERGE (p)-[:USES_METHOD {context: 'Used to generate cAR1 mutants cm1234 and T289 to study the role of phosphorylation.'}]->(m);
