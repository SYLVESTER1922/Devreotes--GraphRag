MERGE (p:Paper {number: '083'}) SET p.title = 'Signal Transduction by G-Proteins in Dictyostelium discoideum', p.year = 1993, p.journal = 'GTPases in biology', p.doi = '', p.key_findings = 'The study identifies at least eight distinct G-protein α subunits in Dictyostelium discoideum, each with unique expression patterns during development. cAMP receptors play a crucial role in mediating the aggregation process, and specific G-proteins like Ga2 are essential for signaling and development. The diversity of G-proteins suggests that they may be involved in different signal transduction pathways, highlighting the complexity of cellular communication in this model organism.', p.paper_type = 'research_article', p.authors = 'Wu, L., Gaskins, C., Gundersen, R., Hadwiger, J.A., Johnson, R.L., Pitt, G.S., Firtel, R.A., Devroetes, P.N.';
