MERGE (c:Concept {name: 'cAMP signaling'}) WITH c MATCH (p:Paper {number: '056'}) MERGE (p)-[:EXPLORES_CONCEPT {context: 'cAMP functions as a signal molecule during chemotaxis, morphogenesis, and cell differentiation in Dictyostelium discoideum.'}]->(c);
MERGE (c:Concept {name: 'down-regulation'}) WITH c MATCH (p:Paper {number: '056'}) MERGE (p)-[:EXPLORES_CONCEPT {context: 'Down-regulation refers to the loss of cAMP-binding activity without a loss of receptor protein.'}]->(c);
