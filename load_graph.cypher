MERGE (p:Paper {number: '183'}) SET p.title = 'Electrical signals control wound healing through phosphatidylinositol-3-OH kinase-g and PTEN', p.year = 2006, p.journal = 'Nature', p.doi = '10.1038/nature04925', p.key_findings = 'The study demonstrates that electric fields serve as crucial directional cues for cell migration during wound healing. It identifies phosphatidylinositol-3-OH kinase-g (PI(3)Kg) and PTEN as key regulators of electrotaxis, with genetic disruption of these proteins impairing or enhancing cell migration in response to electric signals. The findings suggest that electrical signals can independently guide cell movement, highlighting their potential role in therapeutic strategies for wound healing.', p.paper_type = 'research_article', p.authors = 'Zhao, M., Song, B., Pu, J., Wada, T., Reid, B., Tai, G., Wang, F., Guo, A., Walczysko, P., Gu, Y., Sasaki, T., Suzuki, A., Forrester, J.V., Bourne, H.R., Devreotes, P.N., McCaig, C.D., Penninger, J.M.';
