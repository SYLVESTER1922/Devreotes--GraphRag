MERGE (p:Paper {number: '010'}) SET p.title = 'Kinetics of Biosynthesis of Acetylcholine Receptor and Subsequent Incorporation into Plasma Membrane of Cultured Chick Skeletal Muscle', p.year = 1977, p.journal = 'Cell', p.doi = '', p.key_findings = 'The study found that 20% of acetylcholine receptors in cultured chick skeletal muscle remain unbound after long-term growth in the presence of α-bungarotoxin. Newly synthesized receptors were shown to be processed and transported to the plasma membrane, with a significant density shift observed between isotopically labeled and unlabeled receptors. The kinetics of receptor biosynthesis and their incorporation into the plasma membrane were characterized, revealing a lag phase before labeled receptors appeared at the surface, confirming the existence of a pool of presynthesized receptors.', p.paper_type = 'research_article', p.authors = 'Devreotes, P. N., Gardner, J. M., Fambrough, D. M.';
