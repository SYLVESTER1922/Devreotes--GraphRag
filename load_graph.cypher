MERGE (p:Paper {number: '155'}) SET p.title = 'Visualizing PI3 Kinase-Mediated Cell-Cell Signaling during Dictyostelium Development', p.year = 2002, p.journal = 'Current Biology', p.doi = '10.1016/S0960-9822(02)00950-8', p.key_findings = 'The study demonstrates that CRAC-GFP translocation is a key indicator of PI3 kinase-mediated cell-cell signaling during the aggregation of Dictyostelium discoideum. The dynamics of CRAC localization to the membrane are influenced by cAMP signaling, which is essential for chemotaxis and cell polarization. The findings suggest that the mechanisms of cell signaling and movement are tightly regulated during the multicellular development of Dictyostelium, providing insights into the fundamental processes of cell communication and behavior.', p.paper_type = 'research_article', p.authors = 'Dormann, D., Weijer, G., Parent, C.A., Devreotes, P.N., Weijer, C.J.';
