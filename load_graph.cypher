MERGE (m:Method {name: 'Motility in Spatial Gradient'}) WITH m MATCH (p:Paper {number: '140'}) MERGE (p)-[:USES_METHOD {context: 'Cells were tested for their ability to move towards a cAMP gradient.'}]->(m);
MERGE (m:Method {name: 'Time-lapse video analysis'}) WITH m MATCH (p:Paper {number: '140'}) MERGE (p)-[:USES_METHOD {context: 'Time-lapse videos were used to observe and quantify the chemotactic behavior of cells.'}]->(m);
