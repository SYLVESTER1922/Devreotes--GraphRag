MERGE (p:Paper {number: '095'}) SET p.title = 'Two cAMP Receptors Activate Common Signaling Pathways in Dictyostelium', p.year = 1994, p.journal = 'Molecular Biology of the Cell', p.doi = '', p.key_findings = 'The study demonstrates that both cAR1 and cAR3 receptors are involved in mediating responses to cAMP in Dictyostelium discoideum, with cAR1 being the primary receptor. Deletion of cAR1 results in a significant reduction in cAMP responses, but cAR3 can partially compensate for this loss. The research highlights the redundancy in cAMP receptor signaling pathways and their importance in the developmental processes of Dictyostelium. The findings suggest that both receptors interact with the same heterotrimeric G-protein to mediate these responses.', p.paper_type = 'research_article', p.authors = 'Insall, R.H., Soede, R.D.M., Schaap, P., Devreotes, P.N.';
