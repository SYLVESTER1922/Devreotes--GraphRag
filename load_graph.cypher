MERGE (p:Paper {number: '124'}) SET p.title = 'Role of cAMP-Dependent Protein Kinase in Controlling Aggregation and Postaggregative Development in Dictyostelium', p.year = 1997, p.journal = 'Developmental Biology', p.doi = '', p.key_findings = 'The study demonstrates that cAMP-dependent protein kinase (PKA) is crucial for aggregation and postaggregative development in Dictyostelium discoideum. PKA activity regulates multiple aspects of aggregation, including the expression of adenylyl cyclase and the transcription factor GBF. The inability of pkacat0 cells to aggregate is linked to their failure to activate adenylyl cyclase in response to cAMP. Furthermore, while pkacat0 cells can induce some postaggregative gene expression, they do not fully differentiate into prespore cells, highlighting the essential regulatory roles of PKA in multicellular development.', p.paper_type = 'research_article', p.authors = 'Mann, S.K.O., Brown, J.M., Briscoe, C., Parent, C., Pitt, G., Devreotes, P.N., Firtel, R.A.';
MERGE (pr:Protein {name: 'cAMP-dependent protein kinase (PKA)'}) WITH pr MATCH (p:Paper {number: '124'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'PKA is essential for aggregation and postaggregative development in Dictyostelium.'}]->(pr);
