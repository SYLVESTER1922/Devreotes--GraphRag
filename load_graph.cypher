MERGE (p:Paper {number: '134'}) SET p.title = 'A Cell’s Sense of Direction', p.year = 1999, p.journal = 'Science', p.doi = '', p.key_findings = 'The review discusses how eukaryotic cells, such as Dictyostelium discoideum and mammalian leukocytes, utilize G protein-linked signaling pathways for directional sensing. It highlights the uniform distribution of receptors and G proteins around the cell perimeter, which allows for effective detection of chemoattractant gradients. The study emphasizes that actin polymerization and other cytoskeletal changes are not essential for directional sensing, as cells can still respond to gradients without movement. This understanding of chemotaxis has implications for various biological processes, including immunity and wound healing.', p.paper_type = 'review', p.authors = 'Parent, C.A., Devreotes, P.N.';
