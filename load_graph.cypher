MERGE (p:Paper {number: '115'}) SET p.title = 'Adenylyl Cyclase G, an Osmosensor Controlling Germination of Dictyostelium Spores', p.year = 1996, p.journal = 'The Journal of Biological Chemistry', p.doi = '', p.key_findings = 'The study demonstrates that ACG acts as an osmosensor that inhibits spore germination in Dictyostelium discoideum by activating PKA in response to high osmolarity. ACG null mutants (acg2) showed normal development but lost the ability to respond to osmotic signals, indicating the critical role of ACG in spore dormancy. Additionally, the research highlights the importance of cAMP signaling in regulating spore germination and suggests that ACG may have intrinsic osmosensing activity.', p.paper_type = 'research_article', p.authors = 'van Es, Saskia, Virdy, Kiran J., Pitt, Geoffrey S., Meima, Marcel, Sands, Todd W., Devreotes, Peter N., Cotter, David A., Schaap, Pauline';
