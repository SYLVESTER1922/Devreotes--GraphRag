MERGE (p:Paper {number: '270'}) SET p.title = 'Electric field modulation of ERK dynamics shows dependency on waveform and timing', p.year = 2024, p.journal = 'Scientific Reports', p.doi = '10.1038/s41598-024-53018-y', p.key_findings = 'The study demonstrates that electric field stimulation induces a biphasic response in ERK signaling, characterized by both inhibition and activation phases. The response is sensitive to the waveform and timing of the electric field pulses. Additionally, the involvement of EGFR and Ras in the modulation of ERK dynamics highlights the complexity of the signaling pathways affected by electric fields. These findings suggest potential applications in controlling cell behavior and fate through precise electric field manipulation.', p.paper_type = 'research_article', p.authors = 'Hu, Minxi, Li, Houpu, Zhu, Kan, Guo, Liang, Zhao, Min, Zhan, Huiwang, Devreotes, Peter N., Qing, Quan';
