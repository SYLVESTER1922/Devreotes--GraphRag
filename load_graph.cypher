MERGE (p:Paper {number: '277'}) SET p.title = 'Dynamic and Biphasic Regulation of Cell Migration by Ras', p.year = 2025, p.journal = 'bioRxiv', p.doi = '10.1101/2025.02.13.638204', p.key_findings = 'The study demonstrates that Ras activity has a complex and biphasic role in regulating cell migration, where both excessive and insufficient Ras activity can impair movement. Local recruitment of RasGEFs promotes protrusion formation and directional migration, while RasGAPs suppress protrusions and can halt migration. Additionally, the findings highlight the importance of cortical tension in effective migration, suggesting that targeting Ras in cancer therapy requires careful consideration of the initial cellular state to avoid promoting metastasis.', p.paper_type = 'research_article', p.authors = 'Lin, Yiyan, Parajón, Eleana, Yuan, Qinling, Ye, Siyu, Qin, Guanghui, Deng, Yu, Borleis, Jane, Koyfman, Ariel, Iglesias, Pablo A., Konstantopoulos, Konstantinos, Robinson, Douglas N., Devreotes, Peter N.';
