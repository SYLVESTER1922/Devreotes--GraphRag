MERGE (c:Concept {name: 'G protein signaling'}) WITH c MATCH (p:Paper {number: '098'}) MERGE (p)-[:EXPLORES_CONCEPT {context: 'The study discusses the role of Ga2 in G protein signaling pathways, particularly in response to cAMP.'}]->(c);
