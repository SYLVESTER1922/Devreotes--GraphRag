MERGE (p:Paper {number: '176'}) SET p.title = 'Temporal and Spatial Regulation of Phosphoinositide Signaling Mediates Cytokinesis', p.year = 2005, p.journal = 'Developmental Cell', p.doi = '10.1016/j.devcel.2005.02.010', p.key_findings = 'The study demonstrates that the spatial and temporal regulation of PI(3,4,5)P3 is critical for cytokinesis in Dictyostelium discoideum. It was found that PI3K and PTEN localize to specific regions of the cell during division, influencing the accumulation of actin and myosin filaments. Mutant strains lacking these proteins exhibited defects in cytokinesis, highlighting the importance of phosphoinositide signaling in cell division. The findings suggest that similar mechanisms may regulate polarity during both cytokinesis and chemotaxis.', p.paper_type = 'research_article', p.authors = 'Chris Janetopoulos, Jane Borleis, Francisca Vazquez, Miho Iijima, Peter Devreotes';
MERGE (pr:Protein {name: 'myosin II'}) WITH pr MATCH (p:Paper {number: '176'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'Myosin II is crucial for the contractile ring that pinches the daughter cells apart during cytokinesis.'}]->(pr);
MERGE (pr:Protein {name: 'PI3K1'}) WITH pr MATCH (p:Paper {number: '176'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'PI3K1 is involved in the regulation of PI(3,4,5)P3 levels during cytokinesis.'}]->(pr);
