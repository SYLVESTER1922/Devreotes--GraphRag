MERGE (p:Paper {number: '187'}) SET p.title = 'RacG Regulates Morphology, Phagocytosis, and Chemotaxis', p.year = 2006, p.journal = 'Eukaryotic Cell', p.doi = '10.1128/EC.00221-06', p.key_findings = 'RacG plays a crucial role in regulating cell morphology, phagocytosis, and chemotaxis in Dictyostelium discoideum. The study demonstrated that RacG is targeted to the plasma membrane and is involved in actin-driven processes. Overexpression of RacG enhances phagocytosis, while RacG-KO cells show defects in chemotaxis. The findings suggest that RacG interacts with specific effectors distinct from other Rho GTPases, highlighting its unique role in cellular signaling.', p.paper_type = 'research_article', p.authors = 'Baggavalli P. Somesh, Georgia Vlahou, Miho Iijima, Robert H. Insall, Peter Devreotes, Francisco Rivero';
