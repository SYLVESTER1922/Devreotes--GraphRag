MERGE (o:Organism {name: 'Dictyostelium discoideum'}) WITH o MATCH (p:Paper {number: '071'}) MERGE (p)-[:USES_ORGANISM {context: 'This organism was used to study the expression and genomic organization of the CAR1 cAMP receptor during development.'}]->(o);
