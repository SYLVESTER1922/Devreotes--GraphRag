MERGE (p:Paper {number: '117'}) SET p.title = 'Random Mutagenesis of the cAMP Chemoattractant Receptor, cAR1, of Dictyostelium EVIDENCE FOR MULTIPLE STATES OF ACTIVATION', p.year = 1997, p.journal = 'The Journal of Biological Chemistry', p.doi = '', p.key_findings = 'The study demonstrates that cAR1 is tolerant to amino acid substitutions in its third intracellular loop, with some mutants retaining full biological function while others show impaired cAMP binding and signal transduction. Specific mutants were identified that could undergo cAMP-dependent phosphorylation but were defective in G protein coupling or Ca2+ influx. The findings suggest that cAR1 activation may involve multiple distinct receptor intermediates, highlighting the complexity of G protein-coupled receptor signaling in Dictyostelium.', p.paper_type = 'research_article', p.authors = 'Milne, J.L.S., Caterina, M.J., Devreotes, P.N.';
