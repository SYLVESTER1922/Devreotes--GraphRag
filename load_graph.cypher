MERGE (p:Paper {number: '040'}) SET p.title = 'Surface Receptor-mediated Activation of Adenylate Cyclase in Dictyostelium: Regulation by Guanine Nucleotides in Wild-Type Cells and Aggregation Deficient Mutants', p.year = 1986, p.journal = 'Journal of Biological Chemistry', p.doi = '', p.key_findings = 'The study demonstrates that guanine nucleotides significantly activate adenylate cyclase in Dictyostelium discoideum, with specific regulation by cAMP. Two mutants, synag 7 and synag 49, were identified as aggregation-deficient, showing that adenylate cyclase activation is crucial for cellular aggregation but not for growth or differentiation. The findings suggest that Dictyostelium provides a valuable model for understanding receptor-mediated signaling pathways and their roles in development.', p.paper_type = 'research_article', p.authors = 'Theibert, A., Devreotes, P.N.';
