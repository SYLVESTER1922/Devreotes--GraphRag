MERGE (p:Paper {number: '230'}) SET p.title = 'Novel protein Callipygian defines the back of migrating cells', p.year = 2015, p.journal = 'Proceedings of the National Academy of Sciences', p.doi = '10.1073/pnas.1509098112', p.key_findings = 'The study identifies Callipygian (CynA) as a novel protein that localizes to the rear of migrating Dictyostelium cells, promoting polarity and enhancing migration efficiency. CynA localization is mediated by distinct mechanisms, including oligomerization and interaction with membrane tethers. Cells lacking CynA exhibit aberrant protrusions and decreased directional persistence, while overexpression leads to exaggerated polarity features. These findings suggest that CynA plays a critical role in establishing cell axis and polarity during migration.', p.paper_type = 'research_article', p.authors = 'Swaney, K.F., Borleis, J., Iglesias, P.A., Devreotes, P.N.';
