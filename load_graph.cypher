MERGE (p:Paper {number: '026'}) SET p.title = 'CAMP-Stimulated Adenylate Cyclase Activation in Dictyostekm discoideum Is Inhibited by Agents Acting at the Cell Surface', p.year = 1984, p.journal = 'DEVELOPMENTAL BIOLOGY', p.doi = '', p.key_findings = 'Concanavalin A is identified as a potent, rapid, noncompetitive inhibitor of CAMP signaling in Dictyostelium discoideum. The study demonstrates that Concanavalin A inhibits adenylate cyclase activation without affecting basal activity or ATP levels. The inhibition is proposed to occur through cross-linking of surface components, which prevents necessary cytoskeletal rearrangements for adenylate cyclase activation. These findings provide insights into the mechanisms of CAMP signaling and its regulation in amoebae.', p.paper_type = 'research_article', p.authors = 'FONTANA, D., DEVREOTES, P.N.';
