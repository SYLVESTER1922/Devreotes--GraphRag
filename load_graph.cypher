MERGE (p:Paper {number: '075'}) SET p.title = 'Molecular insights into eukaryotic chemotaxis', p.year = 1991, p.journal = 'FASEB Journal', p.doi = '', p.key_findings = 'The study reveals that cAMP and G protein signaling are crucial for chemotaxis in Dictyostelium discoideum. It highlights the necessity of the cAMP receptor (cAR1) and G protein α-subunit (Gα2) for the cells\' responsiveness to cAMP. Additionally, the research indicates that while myosin heavy chain is not essential for chemotaxis, it influences the process\'s details. These findings contribute to understanding the molecular basis of chemotaxis in eukaryotic cells.', p.paper_type = 'research_article', p.authors = 'Caterina, M.J., Devreotes, P.N.';
