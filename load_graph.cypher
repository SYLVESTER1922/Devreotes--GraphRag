MERGE (p:Paper {number: '215'}) SET p.title = 'Phosphorylation-mediated PTEN conformational closure and deactivation revealed with protein semisynthesis', p.year = 2013, p.journal = 'eLife', p.doi = '10.7554/eLife.00691', p.key_findings = 'The study reveals that phosphorylation of PTEN on its C-terminal tail leads to a conformational change that reduces its catalytic activity and membrane affinity. The research demonstrates that the phosphorylated form of PTEN adopts a more compact structure, likely due to intramolecular interactions between the C-tail and the C2 domain. These findings provide insights into the regulatory mechanisms of PTEN and suggest potential pharmacological strategies for PTEN activation in cancer therapy.', p.paper_type = 'research_article', p.authors = 'Bolduc, David, Rahdar, Meghdad, Tu-Sekine, Becky, Sivakumaren, Sindhu Carmen, Raben, Daniel, Amzel, L Mario, Devreotes, Peter, Gabelli, Sandra B, Cole, Philip';
