MERGE (p:Paper {number: '060'}) SET p.title = 'Regulation and Function of Gα Protein Subunits in Dictyostelium', p.year = 1999, p.journal = 'Proc. Natl. Acad. Sci. USA', p.doi = '', p.key_findings = 'The study reveals that Gα1 and Gα2 play crucial roles in the developmental regulation of Dictyostelium, with Gα2 being specifically linked to cAMP receptor signaling during aggregation. Overexpression of Gα1 leads to abnormal cell development, indicating its importance in the cell cycle. The research highlights the intricate relationship between G protein signaling and the developmental processes in Dictyostelium, emphasizing the need for precise regulation of these pathways for proper cellular function.', p.paper_type = 'research_article', p.authors = 'A. Kumagai, M. Pupillo, R. Gundersen, R. Miake-Lye, P. N. Devreotes, R. A. Firtel';
