MERGE (p:Paper {number: '145'}) SET p.title = 'Adenylyl Cyclase A Expression Is Tip-Speciﬁc in Dictyostelium Slugs and Directs StatA Nuclear Translocation and CudA Gene Expression', p.year = 2001, p.journal = 'Developmental Biology', p.doi = '10.1006/dbio.2001.0232', p.key_findings = 'The study reveals that adenylyl cyclase A (ACA) expression is specifically localized to the tip of Dictyostelium slugs, directing the nuclear translocation of StatA and the expression of CudA. ACA transcription is regulated by cAMP pulses, with distinct responses to varying concentrations of cAMP. The findings suggest a critical role for ACA in coordinating multicellular development and highlight the importance of tip-specific signaling in this process.', p.paper_type = 'research_article', p.authors = 'Verkerke-van Wijk, I., Fukuzawa, M., Devreotes, P.N., Schaap, P.';
