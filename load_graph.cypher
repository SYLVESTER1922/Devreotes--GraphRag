MERGE (p:Paper {number: '202'}) SET p.title = 'TORC2 and Chemotaxis in Dictyostelium discoideum', p.year = 2010, p.journal = 'The Enzymes, Vol. 28', p.doi = '10.1016/S1874-6047(10)28006-X', p.key_findings = 'The study elucidates the role of the TORC2–PDK–PKB signaling module in mediating chemotaxis in Dictyostelium discoideum. It highlights how PKBA and PKBR1, two homologues of protein kinase B, contribute differently to chemotactic responses. The research also emphasizes the importance of RasC in activating this pathway, and how spatial dysregulation can lead to severe chemotaxis defects. Overall, these findings provide new insights into the mechanisms linking chemotactic signals to cellular movement and morphology.', p.paper_type = 'research_article', p.authors = 'Kamimura, Y., Cai, H., Devreotes, P.N.';
