MERGE (pr:Protein {name: 'Q208L'}) WITH pr MATCH (p:Paper {number: '247'}) MERGE (p)-[:MENTIONS_PROTEIN {context: 'A constitutively active Ga2 mutant used to study complex formation with cAR1.'}]->(pr);
