MERGE (p:Paper {number: '241'}) SET p.title = 'Excitable Signal Transduction Networks in Directed Cell Migration', p.year = 2017, p.journal = 'Annual Review of Cell and Developmental Biology', p.doi = '10.1146/annurev-cellbio-100616-060739', p.key_findings = 'The review discusses the complexity of signal transduction events involved in directed cell migration, highlighting the role of excitable networks in coordinating cellular responses. It emphasizes the importance of various pathways, including those mediated by cARs, FARs, and PI3K, in regulating motility and directional sensing. The authors propose that understanding these networks can provide insights into the mechanisms underlying cell migration in both normal physiological processes and disease states such as cancer metastasis.', p.paper_type = 'review', p.authors = 'Devreotes, P.N., Bhattacharya, S., Edwards, M., Iglesias, P.A., Lampert, T., Miao, Y.';
