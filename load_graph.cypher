MERGE (p:Paper {number: '148'}) SET p.title = 'Regulation of Adenylyl Cyclases by a Region Outside the Minimally Functional Cytoplasmic Domains', p.year = 2001, p.journal = 'The Journal of Biological Chemistry', p.doi = '10.1074/jbc.M106430200', p.key_findings = 'The study identifies that multiple amino acid substitutions at Leu-394 in the adenylyl cyclase ACA can lead to constitutive activity independent of G proteins or cytosolic regulators. The research highlights the importance of regions outside the cytoplasmic loops in regulating the enzyme\'s conformation and activity. Additionally, it demonstrates that certain mutations can restore wild type properties, indicating a complex interplay between different regions of the enzyme.', p.paper_type = 'research_article', p.authors = 'Parent, C.A., Borleis, J., Devreotes, P.N.';
